package webui

import "github.com/chmouel/liseur-sync/internal/insights"

// Insights data carriers (populated by handlers).

type SummaryData struct {
	// Span is what the reader asked for; RangeDays is how many days
	// that came to, which is nought for all time.
	Span      insights.Span
	RangeDays int
	// Bucket is how wide one bar of the activity chart is. Decided in
	// the handler, which is the only place that knows the reader's
	// timezone and the moment being asked about.
	Bucket insights.Bucket
	// Chart is which view of the activity card is on screen, and
	// Calendar whether the other one is worth offering at all.
	Chart         string
	Calendar      bool
	ActiveMinutes float64
	Pages         float64
	Sessions      int
	StreakDays    int
	SpeedPerHour  float64 // progression fraction per hour
	BooksRead     int
	BooksFinished int
}

// BookStatRow is one book in the breakdown of where the
// span's reading went.
type BookStatRow struct {
	WorkID      string
	BookID      string
	Title       string
	Author      string
	Duration    string
	Sittings    string
	Progression float64
	Finished    bool
}

type DayCell struct {
	Date    string
	Minutes float64
}

templ insightsPage(
	prefix string, u userCtx, csrf string,
	sum SummaryData, days []DayCell, recent []SessionRow, books []BookStatRow,
) {
	@layout("Insights", prefix, u, csrf, insightsBody(prefix, csrf, sum, days, recent, books))
}

templ insightsBody(
	prefix string, csrf string,
	sum SummaryData, days []DayCell, recent []SessionRow, books []BookStatRow,
) {
	<header class="insightshead">
		<div>
			<p class="eyebrow">{ sum.Span.Label() }</p>
			<h1>Insights</h1>
			<p class="page-intro">Reading activity and recent sessions.</p>
		</div>
		@spanPicker(sum.Span)
	</header>
	@headlineTotal(sum)
	<section class="cards">
		<div class="stat"><span class="stat-icon">@uiIcon("Library")</span><span class="num">{ i2s(sum.BooksRead) }</span><span class="lbl">books read from</span></div>
		<div class="stat"><span class="stat-icon">@uiIcon("Finished")</span><span class="num">{ i2s(sum.BooksFinished) }</span><span class="lbl">books finished</span></div>
		// The streak deliberately reaches back past the span, so it says
		// so rather than being left to look like another figure about
		// the last week.
		<div class="stat accent"><span class="stat-icon">@uiIcon("Streak")</span><span class="num">{ i2s(sum.StreakDays) }</span><span class="lbl">day streak (all time)</span></div>
		<div class="stat"><span class="stat-icon">@uiIcon("Sessions")</span><span class="num">{ i2s(sum.Sessions) }</span><span class="lbl">sittings</span></div>
		if sum.Pages > 0 {
			<div class="stat"><span class="stat-icon">@uiIcon("Pages")</span><span class="num">{ f0(sum.Pages) }</span><span class="lbl">pages</span></div>
		}
		// Pace is only known where the reading was measured rather than
		// inferred, so an unknown one is left out rather than shown as
		// nought — which would read as "you got nowhere".
		if sum.SpeedPerHour > 0 {
			<div class="stat"><span class="stat-icon">@uiIcon("Pace")</span><span class="num">{ paceValue(sum.SpeedPerHour) }</span><span class="lbl">pace</span></div>
		}
	</section>
	<section class="card">
		<div class="cardhead">
			<div><p class="eyebrow">The reading habit</p><h2>{ chartHeading(sum.Span, sum.Chart) }</h2></div>
			if sum.Calendar {
				@chartTabs(sum)
			}
		</div>
		if len(days) == 0 {
			<p class="muted">Nothing read in this span. Try a longer one.</p>
		} else if sum.Chart == chartCalendar {
			@readingHeatmap(days)
		} else {
			@dayBars(days, sum.Bucket)
		}
	</section>
	if len(books) > 0 {
		<section class="card" id="by-book">
			<div class="cardhead">
				<div><p class="eyebrow">Where the time went</p><h2>By book</h2></div>
				<span class="count-badge">{ i2s(len(books)) }</span>
			</div>
			<ul class="bookstats">
				for _, b := range books {
					@bookStatRow(prefix, b)
				}
			</ul>
		</section>
	}
	<section class="card">
		<h2>Recent sessions</h2>
		if len(recent) == 0 {
			<p class="muted">No sessions yet. They appear once a device syncs.</p>
		} else {
			<table>
				<tr><th>When</th><th>Work</th><th>Device</th><th>Duration</th><th>Progress</th></tr>
				for _, s := range recent {
					<tr>
						<td>{ s.When }</td>
						<td><a href={ prefix + "works/" + s.WorkID }>{ s.WorkTitle }</a></td>
						<td class="session-device">
							if s.DeviceName != "" {
								<span class="device-name" title={ s.DeviceName }>{ s.DeviceName }</span>
							}
							<code class="device-id" title={ s.DeviceID }>{ s.DeviceIDShort }</code>
						</td>
						<td>{ s.Duration }</td>
						<td>{ pct(s.StartProg) } → { pct(s.EndProg) }</td>
					</tr>
				}
			</table>
		}
	</section>
}

// headlineTotal is the one number the page is about, said once and
// said large: how long this reader spent reading over the span they
// asked about.
templ headlineTotal(sum SummaryData) {
	<section class="card headline-total">
		<p class="headline-label"><span class="headline-icon">@uiIcon("Minutes")</span> Time spent reading</p>
		<p class="headline-value">{ readingMinutes(sum.ActiveMinutes) }</p>
		<p class="headline-caption">{ spanCaption(sum.Span) }</p>
	</section>
}

// chartTabs switches the activity card between how much and when.
//
// Two links rather than a control: they carry the span with them, so
// each is a URL that means what it says and can be bookmarked, and
// there is no script and no inline style between the reader and the
// other view.
templ chartTabs(sum SummaryData) {
	<nav class="charttabs" aria-label="Chart view">
		if sum.Chart == chartCalendar {
			<a href={ chartHref(sum.Span, chartBars) }>Bars</a>
			<span aria-current="true">Calendar</span>
		} else {
			<span aria-current="true">Bars</span>
			<a href={ chartHref(sum.Span, chartCalendar) }>Calendar</a>
		}
	</nav>
}

// bookStatRow is one book's share of the span.
templ bookStatRow(prefix string, b BookStatRow) {
	<li class="bookstat">
		<div class="bookstat-what">
			<a class="bookstat-title" href={ prefix + "works/" + b.WorkID }>{ b.Title }</a>
			if b.Author != "" {
				<span class="bookstat-author">{ b.Author }</span>
			}
			if b.Finished {
				<span class="bookstat-state finished">@uiIcon("Finished") Finished</span>
			} else if b.Progression > 0 {
				<span class="bookstat-state">
					<span class="bookstat-track"><span class={ "bookstat-fill " + pctClass(b.Progression) }></span></span>
					{ pct(b.Progression) + " through" }
				</span>
			}
		</div>
		<div class="bookstat-much">
			<span class="bookstat-duration">{ b.Duration }</span>
			<span class="bookstat-sittings">{ b.Sittings }</span>
		</div>
	</li>
}





// spanPicker is how far back the insights page looks.
//
// A menu rather than a row of chips: six spans across a phone would
// either wrap into a paragraph or shrink to initials, and this is a
// control a reader touches rarely and deliberately. It submits itself
// where there is scripting (static/ui.js) and shows its button where
// there is not, like every other picker here.
templ spanPicker(current insights.Span) {
	// No action: insights is the only page this draws on, and a
	// form without one submits to wherever it already is.
	<form class="spanpick" method="get">
		<label class="visually-hidden" for="span-pick">How far back</label>
		<select id="span-pick" name="span">
			for _, s := range insights.Spans {
				if s == current {
					<option value={ string(s) } selected>{ s.Label() }</option>
				} else {
					<option value={ string(s) }>{ s.Label() }</option>
				}
			}
		</select>
		<noscript><button type="submit">Show</button></noscript>
	</form>
}

// dayBars is one bar per bucket: a day where the days still fit, a
// week, a month or a year where they do not.
//
// Only every seventh daily bar is captioned, counted back from the last
// so that today always carries its own label. Captioning all thirty
// turns the axis into a smear; captioning every fifth lands on a
// different weekday each time the span changes. Wider buckets are few
// enough to name one for one.
templ dayBars(days []DayCell, bucket insights.Bucket) {
	{{ chart := layOutBars(days, bucket) }}
	<div class={ "daybars bars-" + string(bucket) } role="img" aria-label={ chart.Label }>
		for _, b := range chart.Bars {
			<div class="daybar" title={ b.Title }>
				if b.Amount != "" {
					<span class="daybar-amt">{ b.Amount }</span>
				}
				<div class="daybar-track"><span class={ b.Class }></span></div>
				<span class="daybar-cap">{ b.Caption }</span>
			</div>
		}
	</div>
}

// readingHeatmap is a square a day: the calendar view of the activity
// card.
//
// Where the bars show how much, this shows when: months of daily bars
// are a picket fence nobody can read a date off, but the same months as
// a grid make the shape of a reading habit visible at a glance — the
// fortnight on holiday, the month nothing happened.
//
// The columns are weeks and the rows are weekdays, which is what makes
// a square findable at all: without the leading padding the grid is a
// spiral and the row a square sits in means nothing. It scrolls, and
// opens at its far end — the reader came to see how this week went, not
// how last January did.
//
// Each month label sits in the column it names, so the two stay
// together whatever the browser does with the widths.
templ readingHeatmap(days []DayCell) {
	{{ grid := layOutHeatmap(days) }}
	<div class="heatwrap" data-scroll-end="1">
		<div class="heatmap" role="img" aria-label={ grid.Label }>
			for _, wk := range grid.Weeks {
				<div class="heatweek">
					<span class="heatmonth" aria-hidden="true">{ wk.Month }</span>
					<div class="heatdays">
						for _, c := range wk.Days {
							if c.Blank {
								<span class="cell blank" aria-hidden="true"></span>
							} else {
								<span class={ c.Class } title={ c.Title }></span>
							}
						}
					</div>
				</div>
			}
		</div>
	</div>
}
