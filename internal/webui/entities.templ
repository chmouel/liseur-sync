package webui

// EntityRow is one series, contributor or tag as a list shows it. The
// count is of the folder's books claiming it, so a row that reads 0 is
// a name the folder still knows and has nothing left to show for.
type EntityRow struct {
	ID        string
	Name      string
	BookCount int
}

type EntitiesView struct {
	FolderID string
	// Kind is the URL segment (`tags`, `series`, …), kept so the page can
	// link back to itself without re-deriving it.
	Kind     string
	Heading  string
	Singular string
	Entities []EntityRow
	NextURL  string
	Notice   string
	Problem  string
	// View and Back drive the grid/list toggle, as on the books page.
	View string
	Back string
}

type EntityBooksView struct {
	FolderID string
	Kind     string
	Heading  string
	Singular string
	Books    []BookRow
	NextURL  string
	View     string
	Back     string
}

templ entitiesPage(prefix string, u userCtx, csrf string, v EntitiesView) {
	@layout(v.Heading, prefix, u, csrf, entitiesBody(prefix, csrf, v))
}

templ entitiesBody(prefix, csrf string, v EntitiesView) {
	<div class="toolbar">
		<h1>{ v.Heading }</h1>
		<span class="spacer"></span>
		@viewToggle(prefix, csrf, v.Back, v.View)
	</div>
	if v.Problem != "" {
		<p class="error" role="alert">{ v.Problem }</p>
	}
	if v.Notice != "" {
		<p class="notice" role="status">{ v.Notice }</p>
	}
	<section class="card">
		if len(v.Entities) == 0 {
			<p class="muted">
				Nothing here yet. These appear as the folder is read.
			</p>
		} else if v.View == viewGrid {
			<div class="grid">
				for _, e := range v.Entities {
					@entityCard(prefix, v, e)
				}
			</div>
		} else {
			<table>
				<tr>
					<th>Name</th>
					<th>Books</th>
				</tr>
				for _, e := range v.Entities {
					<tr>
						<td>
							<a href={ prefix + "folders/" + v.FolderID + "/" + v.Kind + "/" + e.ID }>
								{ e.Name }
							</a>
						</td>
						<td>{ plural(e.BookCount, "book") }</td>
					</tr>
				}
			</table>
		}
		if v.NextURL != "" {
			<p><a href={ prefix + v.NextURL }>Next page</a></p>
		}
	</section>
	<p><a href={ prefix + "library?folder=" + v.FolderID }>Back to the library</a></p>
}

templ entityBooksPage(prefix string, u userCtx, csrf string, v EntityBooksView) {
	@layout(v.Heading, prefix, u, csrf, entityBooksBody(prefix, csrf, v))
}

templ entityBooksBody(prefix, csrf string, v EntityBooksView) {
	<div class="toolbar">
		<h1>{ v.Heading }</h1>
		<span class="spacer"></span>
		@viewToggle(prefix, csrf, v.Back, v.View)
	</div>
	<section class="card">
		if len(v.Books) == 0 {
			<p class="muted">Nothing here — no book in this folder claims it any more.</p>
		} else if v.View == viewGrid {
			<div class="grid">
				for _, b := range v.Books {
					@bookCard(prefix, b)
				}
			</div>
		} else {
			<table>
				<tr><th>Title</th><th>Added</th></tr>
				for _, b := range v.Books {
					<tr>
						<td><a href={ prefix + "books/" + b.ID }>{ orPlaceholder(b.Title) }</a></td>
						<td>{ b.Added }</td>
					</tr>
				}
			</table>
		}
		if v.NextURL != "" {
			<p><a href={ prefix + v.NextURL }>Next page</a></p>
		}
	</section>
	<p>
		<a href={ prefix + "folders/" + v.FolderID + "/" + v.Kind }>
			All { v.Kind }
		</a>
		{ " · " }
		<a href={ prefix + "library?folder=" + v.FolderID }>Back to the library</a>
	</p>
}
