package webui

// The shell (ADR-0011): a top bar, a persistent left rail, and a content
// column. prefix is the relative path back to the UI root ("" or "../"),
// so every URL below stays correct when the app is served under a
// stripped subpath.
//
// The drawer on a narrow screen is a checkbox and a label rather than a
// script, because navigation is not somewhere to start depending on
// JavaScript when no other part of this UI does.

templ layout(title string, prefix string, u userCtx, csrf string, body templ.Component) {
	<!doctype html>
	<html lang="en" data-theme={ u.Prefs.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// htmx would otherwise inject a <style> element into this head
			// at load, which the page's CSP refuses. The rules it wanted to
			// add live in style.css instead, spelled the same way.
			<meta name="htmx-config" content="{&#34;includeIndicatorStyles&#34;:false}"/>
			<title>{ title } · liseur-sync</title>
			<link rel="shortcut icon" href={ prefix + "static/favicon.ico" }/>
			<link rel="icon" href={ prefix + "static/icon.png" }/>
			<link rel="icon" type="image/svg+xml" sizes="any" href={ prefix + "static/favicon.svg" }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ prefix + "static/apple-touch-icon.png" }/>
			if u.Offline {
				<link rel="manifest" href={ prefix + "offline/manifest.json" }/>
			}
			<link rel="stylesheet" href={ prefix + "static/style.css" }/>
			<script src={ prefix + "static/htmx.min.js" } defer></script>
			<script src={ prefix + "static/ui.js" } defer></script>
			if u.Offline {
				<script type="module" src={ prefix + "static/offline-account.js" } defer></script>
				<script type="module" src={ prefix + "static/offline-download.js" } defer></script>
			}
		</head>
		<body data-pwa-base={ pwaBase(prefix, u.Offline) } data-offline-account={ offlineAccount(u) }>
			<a class="skip" href="#content">Skip to content</a>
			if u.User != nil {
				<input type="checkbox" id="nav-toggle" class="nav-toggle"/>
				<div class="app">
					<header class="topbar">
						<label class="nav-open" for="nav-toggle" title="Menu">
							<span aria-hidden="true">☰</span>
							<span class="visually-hidden">Menu</span>
						</label>
						<a class="brand" href={ prefix + "." }>
							<img class="brand-icon" src={ prefix + "static/icon.svg" } width="32" height="32" alt=""/>
							<span class="brand-name"><span class="brandmark">Liseur</span><span class="suffix">sync</span></span>
						</a>
						<span class="topbar-context">{ title }</span>
						<div class="account">
							@themeToggle(prefix, csrf, u)
							<span class="who"><span class="account-avatar" aria-hidden="true">@uiIcon("Account")</span>{ u.User.Name }</span>
							<form method="post" action={ prefix + "logout" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								<button class="link" type="submit">Log out</button>
							</form>
						</div>
					</header>
					<label class="nav-scrim" for="nav-toggle" aria-hidden="true"></label>
					<aside class="rail">
						<p class="rail-caption">Your reading space</p>
						<nav aria-label="Sections">
							@railLink(prefix+".", "Dashboard", u.Section == "dashboard")
							@railLink(prefix+"library", "Library", u.Section == "library")
							if u.IsAdmin {
								@railLink(settingsAdminHref(prefix, settingsAdminFolders), "Folders", u.Section == "folders")
							}
							@railLink(prefix+"settings", "Settings", u.Section == "settings")
						</nav>
						<div class="rail-note">
							<p>A library<br/><em>of your own.</em></p>
						</div>
					</aside>
					<main id="content">
						<div class="page">
							@body
							<footer class="foot">Liseur Sync</footer>
						</div>
					</main>
				</div>
			} else {
				<main id="content" class="auth-main">
					@body
				</main>
			}
		</body>
	</html>
}

// railLink marks the current section for a screen reader as well as for
// an eye: aria-current is what the styling hangs off, so the two cannot
// drift apart.
templ railLink(href string, label string, current bool) {
	if current {
		<a href={ href } aria-current="page">@uiIcon(label)<span>{ label }</span></a>
	} else {
		<a href={ href }>@uiIcon(label)<span>{ label }</span></a>
	}
}

// Shared line icons keep navigation and reading summaries visually consistent.
templ uiIcon(name string) {
	<svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		switch name {
			case "Dashboard":
				<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>
			case "Library":
				<path d="M12 6v15M3 4c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2Z"/>
			case "Folders":
				<path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm0 2h18"/>
			case "Settings":
				<path d="M4 7h7m4 0h5M4 17h3m4 0h9"/><circle cx="13" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>
			case "Account":
				<circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
			case "Minutes":
				<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
			case "Sessions":
				<path d="M4 20V10m8 10V4m8 16v-7"/>
			case "Streak":
				<path d="M13 3c1 5 5 6 5 11a6 6 0 0 1-12 0c0-3 2-5 3-6 0 3 1 4 2 4 2-2 3-5 2-9Z"/>
		}
	</svg>
}

// themeToggle cycles dark → light → system → Tokyo Night → Rosé Pine. One
// button rather than five keeps the top bar quiet, and the label says
// which way it is going.
templ themeToggle(prefix string, csrf string, u userCtx) {
	<form method="post" action={ prefix + "preferences" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="theme" value={ nextTheme(u.Prefs.Theme) }/>
		<input type="hidden" name="back" value={ u.Back }/>
		<button class="link" type="submit" title={ "Theme: " + u.Prefs.Theme }>
			{ themeGlyph(u.Prefs.Theme) }
			<span class="visually-hidden">
				{ "Switch theme to " + nextTheme(u.Prefs.Theme) }
			</span>
		</button>
	</form>
}

// forbiddenPage is what a non-admin gets for typing an admin URL. It is
// the shell rather than a bare error string so the reader keeps a way
// out, and it says how admin rights are granted, since the answer is
// not "ask the UI" — there is no button for it anywhere.
templ forbiddenPage(prefix string, u userCtx, csrf string) {
	@layout("Not allowed", prefix, u, csrf, forbiddenBody(prefix))
}

templ forbiddenBody(prefix string) {
	<section class="card narrow">
		<h1>Not allowed</h1>
		<p>This page is for administrators, and this account is not one.</p>
		<p class="muted">
			Administrator rights belong to the account, not to a token. An
			existing administrator grants them, or the operator does with
			<code>liseur-sync admin grant-admin</code>.
		</p>
		<p><a href={ prefix + "." }>Back to the dashboard</a></p>
	</section>
}

// loginPage is the unauthenticated entry point, rendered at /ui/login
// (or re-rendered from POST /ui/login on bad credentials).
templ loginPage(prefix string, u userCtx, errMsg string) {
	@layout("Sign in", prefix, u, "", loginBody(prefix, errMsg))
}

templ loginBody(prefix string, errMsg string) {
	@authFrame(prefix) {
		<p class="auth-eyebrow">Your reading space</p>
		<h1>Welcome back.</h1>
		<p class="auth-intro">Sign in and pick up your next chapter.</p>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<form class="auth-form" method="post" action={ prefix + "login" }>
			<label>Username <input name="username" required autofocus autocomplete="username" autocapitalize="none" spellcheck="false"/></label>
			<label>Password <input name="password" type="password" required autocomplete="current-password"/></label>
			<button type="submit" class="auth-submit">Sign in <span aria-hidden="true">→</span></button>
		</form>
	}
}

templ authFrame(prefix string) {
	<div class="auth-wrap">
		<div class="auth-shell">
			<aside class="auth-story" aria-label="Liseur Sync">
				<p class="auth-brand">Liseur <span>sync</span></p>
				<img class="auth-icon" src={ prefix + "static/icon.svg" } width="112" height="112" alt=""/>
				<p class="auth-headline">Every book.<br/>Right where<br/><em>you left it.</em></p>
				<p class="auth-story-copy">A home for your books, with your reading place kept across devices.</p>
				<p class="auth-story-foot"><span aria-hidden="true">✦</span> Self-hosted. Made for readers.</p>
			</aside>
			<section class="auth-panel">
				{ children... }
			</section>
		</div>
		<p class="auth-footer">Liseur Sync</p>
	</div>
}

// setupPage is the first-run screen: the only page in the UI that an
// anonymous visitor may act on, and only while the instance has no
// accounts.
templ setupPage(prefix string, u userCtx, errMsg string) {
	@layout("Set up", prefix, u, "", setupBody(prefix, errMsg))
}

templ setupBody(prefix string, errMsg string) {
	@authFrame(prefix) {
		<p class="auth-eyebrow">Your first chapter</p>
		<h1>Make yourself at home.</h1>
		<p class="auth-intro">Create your account to start your library.</p>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<form class="auth-form" method="post" action={ prefix + "setup" }>
			<label>Username <input name="username" required autofocus autocomplete="username" autocapitalize="none" spellcheck="false"/></label>
			<label>
				Password
				<input name="password" type="password" required autocomplete="new-password" minlength={ minPasswordLength } aria-describedby="password-hint"/>
				<span class="auth-hint" id="password-hint">At least { minPasswordLength } characters.</span>
			</label>
			<label>Confirm password <input name="repeat" type="password" required autocomplete="new-password"/></label>
			<button type="submit" class="auth-submit">Create administrator <span aria-hidden="true">→</span></button>
		</form>
		<p class="auth-note">This first account manages your library and other accounts. You can add readers once you’re in.</p>
	}
}
