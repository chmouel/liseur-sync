package webui

// The shell (ADR-0011): a top bar, a persistent left rail, and a content
// column. prefix is the relative path back to the UI root ("" or "../"),
// so every URL below stays correct when the app is served under a
// stripped subpath.
//
// The drawer on a narrow screen is a checkbox and a label rather than a
// script, because navigation is not somewhere to start depending on
// JavaScript when no other part of this UI does.

templ layout(title string, prefix string, u userCtx, csrf string, body templ.Component) {
	<!doctype html>
	<html lang="en" data-theme={ u.Prefs.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// htmx would otherwise inject a <style> element into this head
			// at load, which the page's CSP refuses. The rules it wanted to
			// add live in style.css instead, spelled the same way.
			<meta name="htmx-config" content="{&#34;includeIndicatorStyles&#34;:false}"/>
			<title>{ title } · liseur-sync</title>
			<link rel="icon" href={ prefix + "static/liseur.png" }/>
			<link rel="stylesheet" href={ prefix + "static/style.css" }/>
			<script src={ prefix + "static/htmx.min.js" } defer></script>
			<script src={ prefix + "static/ui.js" } defer></script>
		</head>
		<body>
			<a class="skip" href="#content">Skip to content</a>
			if u.User != nil {
				<input type="checkbox" id="nav-toggle" class="nav-toggle"/>
				<div class="app">
					<header class="topbar">
						<label class="nav-open" for="nav-toggle" title="Menu">
							<span aria-hidden="true">☰</span>
							<span class="visually-hidden">Menu</span>
						</label>
						<a class="brand" href={ prefix + "." }>
							<span class="brandmark" role="img" aria-label="Liseur sync"></span>
							<span class="suffix" aria-hidden="true">sync</span>
						</a>
						<form class="topsearch" method="get" action={ prefix + "search" }>
							<input
								type="search"
								name="q"
								placeholder="Search titles, authors, series…"
								aria-label="Search the library"
							/>
						</form>
						<div class="account">
							@themeToggle(prefix, csrf, u)
							<span class="who">{ u.User.Name }</span>
							<form method="post" action={ prefix + "logout" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								<button class="link" type="submit">Log out</button>
							</form>
						</div>
					</header>
					<label class="nav-scrim" for="nav-toggle" aria-hidden="true"></label>
					<aside class="rail">
						<nav aria-label="Sections">
							@railLink(prefix+".", "Dashboard", u.Section == "dashboard")
							@railLink(prefix+"library", "Library", u.Section == "library")
							<span class="rail-head">Account</span>
							@railLink(prefix+"devices", "Devices", u.Section == "devices")
							@railLink(prefix+"settings", "Settings", u.Section == "settings")
							if u.IsAdmin {
								// Straight to Folders, not the overview: the
								// overview only summarises the pages beside it,
								// and adding or checking a folder is what an
								// operator opens Admin to do.
								@railLink(prefix+"admin/folders", "Admin", u.Section == "admin")
							}
						</nav>
					</aside>
					<main id="content">
						<div class="page">
							@body
							<footer class="foot">liseur-sync · self-hosted reading sync</footer>
						</div>
					</main>
				</div>
			} else {
				<main id="content">
					@body
				</main>
			}
		</body>
	</html>
}

// railLink marks the current section for a screen reader as well as for
// an eye: aria-current is what the styling hangs off, so the two cannot
// drift apart.
templ railLink(href string, label string, current bool) {
	if current {
		<a href={ href } aria-current="page">{ label }</a>
	} else {
		<a href={ href }>{ label }</a>
	}
}

// themeToggle cycles dark → light → system → Tokyo Night → Rosé Pine. One
// button rather than five keeps the top bar quiet, and the label says
// which way it is going.
templ themeToggle(prefix string, csrf string, u userCtx) {
	<form method="post" action={ prefix + "preferences" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="theme" value={ nextTheme(u.Prefs.Theme) }/>
		<input type="hidden" name="back" value={ u.Back }/>
		<button class="link" type="submit" title={ "Theme: " + u.Prefs.Theme }>
			{ themeGlyph(u.Prefs.Theme) }
			<span class="visually-hidden">
				{ "Switch theme to " + nextTheme(u.Prefs.Theme) }
			</span>
		</button>
	</form>
}

// forbiddenPage is what a non-admin gets for typing an admin URL. It is
// the shell rather than a bare error string so the reader keeps a way
// out, and it says how admin rights are granted, since the answer is
// not "ask the UI" — there is no button for it anywhere.
templ forbiddenPage(prefix string, u userCtx, csrf string) {
	@layout("Not allowed", prefix, u, csrf, forbiddenBody(prefix))
}

templ forbiddenBody(prefix string) {
	<section class="card narrow">
		<h1>Not allowed</h1>
		<p>This page is for administrators, and this account is not one.</p>
		<p class="muted">
			Administrator rights belong to the account, not to a token. An
			existing administrator grants them, or the operator does with
			<code>liseur-sync admin grant-admin</code>.
		</p>
		<p><a href={ prefix + "." }>Back to the dashboard</a></p>
	</section>
}

// loginPage is the unauthenticated entry point, rendered at /ui/login
// (or re-rendered from POST /ui/login on bad credentials).
templ loginPage(prefix string, u userCtx, errMsg string) {
	@layout("Sign in", prefix, u, "", loginBody(prefix, errMsg))
}

templ loginBody(prefix string, errMsg string) {
	<section class="card narrow">
		<h1>Sign in</h1>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<form method="post" action={ prefix + "login" }>
			<label>Username <input name="username" required autofocus/></label>
			<label>Password <input name="password" type="password" required/></label>
			<button type="submit" class="primary">Sign in</button>
		</form>
	</section>
}

// setupPage is the first-run screen: the only page in the UI that an
// anonymous visitor may act on, and only while the instance has no
// accounts.
templ setupPage(prefix string, u userCtx, errMsg string) {
	@layout("Set up", prefix, u, "", setupBody(prefix, errMsg))
}

templ setupBody(prefix string, errMsg string) {
	<section class="card narrow">
		<h1>Welcome</h1>
		<p class="muted">
			This instance has no accounts yet. The account you make here is the
			first one, and it is an administrator: it can create the others,
			reset passwords and reach the admin section. This page closes as
			soon as it exists.
		</p>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<form method="post" action={ prefix + "setup" }>
			<label>Username <input name="username" required autofocus autocomplete="username"/></label>
			<label>
				Password
				<input name="password" type="password" required autocomplete="new-password" minlength={ minPasswordLength }/>
			</label>
			<label>Repeat <input name="repeat" type="password" required autocomplete="new-password"/></label>
			<button type="submit" class="primary">Create administrator</button>
		</form>
	</section>
}
