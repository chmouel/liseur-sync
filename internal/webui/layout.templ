package webui

import "github.com/chmouel/liseur-sync/internal/store"

// layout wraps every page: nav, flash area, htmx.
templ layout(title string, u *store.User, csrf string, body templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · liseur-sync</title>
			<link rel="stylesheet" href="/ui/static/style.css"/>
			<script src="/ui/static/htmx.min.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/ui">liseur-sync</a>
				if u != nil {
					<nav>
						<a href="/ui">Dashboard</a>
						<a href="/ui/works">Library</a>
						<a href="/ui/devices">Devices</a>
						<a href="/ui/settings">Settings</a>
						<a href="/ui/admin">Admin</a>
					</nav>
					<form method="post" action="/ui/logout" class="logout">
						<input type="hidden" name="csrf" value={ csrf }/>
						<button class="link" type="submit">Log out { u.Name }</button>
					</form>
				}
			</header>
			<main>
				@body
			</main>
			<footer class="foot">liseur-sync · self-hosted reading sync</footer>
		</body>
	</html>
}

// loginPage is the unauthenticated entry point.
templ loginPage(errMsg string) {
	@layout("Sign in", nil, "", loginBody(errMsg))
}

templ loginBody(errMsg string) {
	<section class="card narrow">
		<h1>Sign in</h1>
		if errMsg != "" {
			<p class="error">{ errMsg }</p>
		}
		<form method="post" action="/ui/login">
			<label>Username <input name="username" required autofocus/></label>
			<label>Password <input name="password" type="password" required/></label>
			<button type="submit" class="primary">Sign in</button>
		</form>
	</section>
}
