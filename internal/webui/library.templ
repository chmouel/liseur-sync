package webui

// The library page (ADR-0011): one wall of covers, whatever the row is
// made of. See library.go for why the two pages this replaces became
// one, and for what each chip means.

templ libraryPage(prefix string, u userCtx, csrf string, v LibraryView) {
	@layout("Library", prefix, u, csrf, libraryBody(prefix, csrf, u.IsAdmin, v))
}

templ libraryBody(prefix, csrf string, admin bool, v LibraryView) {
	if v.Problem != "" {
		<p class="error" role="alert">{ v.Problem }</p>
	}
	if v.Notice != "" {
		<p class="notice" role="status">{ v.Notice }</p>
	}
	// The shelf is drawn whether or not a folder is granted. A reader's
	// own works are theirs either way (ADR-0027), and hanging the whole
	// page off the folder list is what made a revoked or never-assigned
	// account look like an empty server — issue #13.
	<header class="libraryhead">
		<div class="libraryhead-row">
			<h1>Library</h1>
			if v.HasGrant() && len(v.Folders) > 1 {
				<form class="folderpick" method="get" action={ prefix + "library" }>
					<label class="visually-hidden" for="folder-pick">Folder</label>
					<div class="folderselect-wrap">
						<span class="folder-glyph" aria-hidden="true">@uiIcon("Folders")</span>
						<select id="folder-pick" name="folder">
							for _, f := range v.Folders {
								if f.Selected {
									<option value={ f.ID } selected>{ f.Name }</option>
								} else {
									<option value={ f.ID }>{ f.Name }</option>
								}
							}
						</select>
					</div>
					<input type="hidden" name="filter" value={ v.Filter }/>
					if v.Sort != sortRecent {
						<input type="hidden" name="sort" value={ v.Sort }/>
					}
					if v.Dir != sortDirDesc {
						<input type="hidden" name="dir" value={ v.Dir }/>
					}
					<noscript><button type="submit">Show</button></noscript>
				</form>
			}
		</div>
		<div class="librarycontrols">
			if v.Selected != "" {
				@searchForm(prefix, SearchView{FolderID: v.Selected}, false)
			}
			@sortPicker(prefix, v)
			@viewToggle(prefix, csrf, v.Back, v.View)
			if v.CanUpload {
				<button
					type="button"
					class="btn upload-btn"
					data-dialog-open="upload-dialog"
					aria-controls="upload-dialog"
				>
					<span class="upload-icon" aria-hidden="true">@uiIcon("Upload")</span>
					<span>Upload</span>
				</button>
			}
			@refreshButton()
		</div>
	</header>
	if !v.HasGrant() {
		<section class="librarynote">
			if !v.ServerHasFolders {
				if admin {
					<p class="muted">
						This server watches no folders yet. Point it at one from
						<a href={ settingsAdminHref(prefix, settingsAdminFolders) }>Folders</a> in
						the Settings panel, or with <code>liseur-sync admin add-folder</code>.
					</p>
				} else {
					<p class="muted">
						This server watches no folders yet. An administrator points
						it at one with <code>liseur-sync admin add-folder</code>.
					</p>
				}
			} else {
				if admin {
					<p class="muted">
						This server watches folders, but none is assigned to your
						account. Administering the server is not the same as reading
						from it: assign one to yourself from
						<a href={ settingsAdminHref(prefix, settingsAdminUsers) }>Users</a> in
						the Settings panel, or with
						<code>liseur-sync admin assign-all-folders</code>.
					</p>
				} else {
					<p class="muted">
						This server watches folders, but none is assigned to your
						account yet. An administrator assigns one. Anything you have
						already been reading is still below.
					</p>
				}
			}
		</section>
	}
	if v.Hero != nil {
		@heroCard(prefix, *v.Hero)
	}
	// The tabs over the shelf say what to show; search and ordering sit in
	// the header. The status filters are links, so a filtered shelf is
	// still a URL somebody can send.
	<div class="shelfbar">
		<div class="shelftabs">
			<nav class="tabs" aria-label="Filter">
				for _, c := range v.Chips {
					if c.Active {
						<a class="on" href={ prefix + c.URL } aria-current="true">{ c.Label }</a>
					} else {
						<a href={ prefix + c.URL }>{ c.Label }</a>
					}
				}
			</nav>
			<div class="shelfextras">
				<nav class="browselinks" aria-label="Browse the library">
					<span class="muted">Browse</span>
					<a href={ prefix + "entities/series" }>Series</a>
					<a href={ prefix + "entities/contributors" }>Contributors</a>
					<a href={ prefix + "entities/tags" }>Tags</a>
				</nav>
				if v.View == viewGrid {
					<form class="groupseries" method="post" action={ prefix + "preferences" }>
						<input type="hidden" name="csrf" value={ csrf }/>
						<input type="hidden" name="back" value={ v.Back }/>
						<input type="hidden" name="set" value="series"/>
						<label class="check" for="group-series-toggle">
							<input
								id="group-series-toggle"
								type="checkbox"
								name="group_series"
								value="1"
								checked?={ v.GroupSeries }
							/>
							Group by series
						</label>
						<noscript><button type="submit">Apply</button></noscript>
					</form>
				}
			</div>
		</div>
	</div>
	<section class="libraryshelf" aria-label="Books">
		if v.View == viewList {
			if len(v.Rows) == 0 {
				@libraryEmpty(v)
			} else {
				@libraryTable(prefix, csrf, v)
			}
		} else {
			if (v.groupedGrid() && len(v.Entries) == 0 && v.NextURL == "") ||
				(!v.groupedGrid() && len(v.Rows) == 0) {
				@libraryEmpty(v)
			} else {
				<div class="grid">
					@libraryFragment(prefix, csrf, v)
				</div>
			}
		}
	</section>
	if v.CanUpload {
		@uploadDialog(prefix, csrf, v.Selected)
	}
}

// sortPicker orders the shelf. Choosing a field resets the direction to
// that field's default, as the old toggle did; the arrow beside it
// reverses whatever is chosen.
templ sortPicker(prefix string, v LibraryView) {
	<form class="sortpick" method="get" action={ prefix + "library" }>
		if v.Selected != "" {
			<input type="hidden" name="folder" value={ v.Selected }/>
		}
		<input type="hidden" name="filter" value={ v.Filter }/>
		<label class="visually-hidden" for="sort-pick">Sort by</label>
		<select id="sort-pick" name="sort">
			<option value={ sortRecent } selected?={ v.Sort == sortRecent }>Recently added</option>
			<option value={ sortLastRead } selected?={ v.Sort == sortLastRead }>Last read</option>
		</select>
		<noscript><button type="submit">Sort</button></noscript>
	</form>
	<a
		class="iconbtn sortdir"
		href={ prefix + v.DirURL }
		title={ dirLabel(v.Dir) + " (click to reverse)" }
		aria-label={ "Sort direction: " + dirLabel(v.Dir) + ". Reverse it." }
	>
		<span aria-hidden="true">{ dirArrow(v.Dir) }</span>
	</a>
}

// libraryEmpty says why the shelf is empty, which depends entirely on
// what was asked for: an empty catalog, an empty filter and a folder
// nobody assigned are three problems with three different answers.
templ libraryEmpty(v LibraryView) {
	switch v.Filter {
		case filterReading:
			@emptyState("Nothing in progress", "Books you have started and not finished appear here.", "", "")
		case filterFinished:
			@emptyState("Nothing finished yet", "Books you have read to the end appear here.", "", "")
		case filterUnread:
			@emptyState("Nothing unread", "Every book here has been opened at least once.", "", "")
		case filterHere:
			if v.CatalogUnavailable() {
				if v.ServerHasFolders {
					@emptyState("No folder is assigned to you", "This server watches folders. An administrator decides which of them are yours.", "", "")
				} else {
					@emptyState("This server watches no folders", "Books appear here once an administrator points the server at a directory.", "", "")
				}
			} else {
				@emptyState("No files on this server", "Books appear here as this server reads the folders it watches.", "", "")
			}
		default:
			@emptyState("Nothing here yet", "Add books to a watched folder, or sync reading progress from Liseur or KOReader.", "", "")
	}
}

// heroCard is the way back into whatever was put down last. It repeats a
// row that is also somewhere in the grid below, on purpose: coming back
// to a half-read book is the single most common reason to open this
// page, and hunting for it among four hundred covers is the thing this
// removes.
templ heroCard(prefix string, row LibraryRow) {
	<section class="resume" aria-labelledby="resume-title">
		<a class="art" href={ row.href(prefix) } title={ row.hint() } tabindex="-1" aria-hidden="true">
			<img
				src={ prefix + "books/" + row.BookID + "/cover?size=full" }
				alt=""
				loading="lazy"
				decoding="async"
				width="333"
				height="500"
			/>
		</a>
		<div class="herotext">
			<p class="herolabel">Continue reading</p>
			<h2 id="resume-title"><a class="title" href={ row.href(prefix) }>{ orPlaceholder(row.Title) }</a></h2>
			if row.Author != "" {
				<p class="by">{ row.Author }</p>
			}
			if row.Progression != nil || row.LastActive != "" {
				<div class="herotrack">
					if row.Progression != nil {
						@progressBar("bar", *row.Progression)
						<span class="pct">{ pctProgression(*row.Progression) }</span>
					}
					if row.LastActive != "" {
						<span class="muted">{ "Last read " + row.LastActive }</span>
					}
				</div>
			}
			<p class="heroactions">
				<a class="btn primary" href={ row.href(prefix) }>Resume reading</a>
				if row.WorkID != "" {
					<a class="quiet" href={ prefix + "works/" + row.WorkID }>Reading log</a>
				}
				<a class="quiet" href={ prefix + "books/" + row.BookID }>Book details</a>
			</p>
		</div>
	</section>
}

// libraryFragment is a page of cards plus the sentinel that fetches the
// next one. It replaces itself, so the cards it brings land inside the
// grid rather than after it.
//
// The sentinel is a link first and a trigger second: with scripting off
// it is the "next page" the table view has always had.
templ libraryFragment(prefix, csrf string, v LibraryView) {
	if v.groupedGrid() {
		for _, entry := range v.Entries {
			if entry.Series != nil {
				@librarySeriesCard(prefix, *entry.Series)
			} else if entry.Row != nil {
				@libraryCard(prefix, csrf, *entry.Row)
			}
		}
	} else {
		for _, row := range v.Rows {
			@libraryCard(prefix, csrf, row)
		}
	}
	if v.NextURL != "" {
		<div
			class="more"
			hx-get={ v.NextURL }
			hx-trigger="revealed"
			hx-swap="outerHTML"
		>
			<a rel="next" href={ v.NextURL }>Next page</a>
			// The sentinel swaps itself out on success; while the fetch is
			// in the air this is the only sign anything is happening.
			<span class="htmx-indicator">Loading…</span>
		</div>
	}
}

// librarySeriesCard mirrors Liseur's compact shelf pile: the next-up
// cover in front, two real volumes peeking out behind it, and one
// progress segment per volume. The count is in the summary line below.
templ librarySeriesCard(prefix string, series LibrarySeries) {
	<article class="bookcard seriescard">
		<a
			class="seriesart"
			href={ prefix + "entities/series/" + series.ID }
			aria-label={ series.Name + ", " + series.Summary() }
		>
			if len(series.BackBookIDs) > 1 {
				<span class="stackback far">
					<img
						src={ prefix + "books/" + series.BackBookIDs[1] + "/cover?size=thumbnail" }
						alt=""
						loading="lazy"
						decoding="async"
						width="333"
						height="500"
					/>
				</span>
			}
			if len(series.BackBookIDs) > 0 {
				<span class="stackback near">
					<img
						src={ prefix + "books/" + series.BackBookIDs[0] + "/cover?size=thumbnail" }
						alt=""
						loading="lazy"
						decoding="async"
						width="333"
						height="500"
					/>
				</span>
			}
			if series.Complete {
				<span class="stackfront complete">
					@seriesStackCover(prefix, series.CoverBookID)
				</span>
			} else {
				<span class="stackfront">
					@seriesStackCover(prefix, series.CoverBookID)
				</span>
			}
		</a>
		<div class="seriesrail" aria-hidden="true">
			for _, volume := range series.Volumes {
				if volume.Row.Finished() {
					<span class="done"></span>
				} else if volume.Row.Started() {
					<span class="started"></span>
				} else {
					<span></span>
				}
			}
		</div>
		<a class="title" href={ prefix + "entities/series/" + series.ID }>
			{ orPlaceholder(series.Name) }
		</a>
		if series.Author != "" {
			<span class="by">{ series.Author }</span>
		}
		<span class="card-activity muted">{ series.Summary() }</span>
	</article>
}

templ seriesStackCover(prefix, bookID string) {
	<img
		src={ prefix + "books/" + bookID + "/cover?size=full" }
		alt=""
		loading="lazy"
		decoding="async"
		width="333"
		height="500"
	/>
}

// libraryCard is one row on the wall. The cover carries on reading when
// there is something to carry on with; everything else a row can do
// lives behind the ⋯ menu beside its title.
//
// The menu is a <details>, so it opens with scripting off and from a
// keyboard. It hangs off the caption rather than the cover: the art is
// an overflow-hidden box, and a panel inside it would be clipped by the
// picture it belongs to. ui.js closes it on Escape, on a click outside,
// and when another one opens.
templ libraryCard(prefix, csrf string, row LibraryRow) {
	<article class="bookcard">
		if row.BookID != "" {
			<div class="art">
				<a href={ row.href(prefix) } title={ row.hint() }>
					<img
						src={ prefix + "books/" + row.BookID + "/cover?size=full" }
						alt=""
						loading="lazy"
						decoding="async"
						width="333"
						height="500"
					/>
				</a>
				if row.Progression != nil {
					@progressBar("prog", *row.Progression)
				}
			</div>
		} else {
			<div class="art art-text">
				<a class="fill" href={ prefix + "works/" + row.WorkID }>
					<span class="name">{ orPlaceholder(row.Title) }</span>
					if row.Author != "" {
						<span class="count">{ row.Author }</span>
					}
					if row.Progression != nil {
						<span class="big">{ pctProgression(*row.Progression) }</span>
					}
					<span class="note">Synced elsewhere</span>
				</a>
			</div>
		}
		<div class="caption">
			<a class="title" href={ row.href(prefix) }>{ orPlaceholder(row.Title) }</a>
			@bookMenu(prefix, csrf, row)
		</div>
		if row.Author != "" {
			<span class="by">{ row.Author }</span>
		} else if row.Added != "" {
			<span class="by muted">{ row.Added }</span>
		}
		if row.Pending {
			<span class="card-activity muted">pending</span>
		} else if row.LastActive != "" {
			<span class="card-activity muted">{ "Read " + row.LastActive }</span>
		}
	</article>
}

// bookMenu is everything a card can do besides reading. "Download"
// serves the stored file as it sits in the folder, so it names the
// format when it knows one.
templ bookMenu(prefix, csrf string, row LibraryRow) {
	<details class="bookmenu">
		<summary title="More actions" aria-label={ "More actions for " + orPlaceholder(row.Title) }>
			<span aria-hidden="true">⋯</span>
		</summary>
		<div class="menu">
			if row.BookID != "" {
				<a href={ prefix + "books/" + row.BookID }>Book details</a>
				@markBookForm(prefix, csrf, row.BookID, row.Finished())
			}
			if row.WorkID != "" {
				<a href={ prefix + "works/" + row.WorkID }>Reading log</a>
				<a href={ prefix + "works/" + row.WorkID + "#sessions" }>Sessions</a>
			}
			if row.CanGet && row.BookID != "" {
				if row.CanRead {
					<a href={ prefix + "books/" + row.BookID + "/download" }>Download EPUB</a>
				} else {
					<a href={ prefix + "books/" + row.BookID + "/download" }>Download file</a>
				}
			}
			if row.Bookless {
				@deleteWorkForm(prefix, csrf, row.WorkID, "closest article")
			}
		</div>
	</details>
}

// deleteWorkForm removes one work of the reader's own from a list,
// without leaving the list: htmx takes the row out where it stood, and
// with scripting off the same form is a plain POST that comes back to
// the library.
//
// It appears only on a work no book on this server backs. A row whose
// book is merely missing keeps its "synced elsewhere" tile and no
// button, because that absence is about a disk rather than a decision
// (ADR-0024).
templ deleteWorkForm(prefix, csrf, workID, target string) {
	<form
		class="inline-delete"
		method="post"
		action={ prefix + "works/" + workID + "/delete" }
		hx-post={ prefix + "works/" + workID + "/delete" }
		hx-target={ target }
		hx-swap="outerHTML"
		hx-confirm="Delete this book's reading history? A device still syncing this book will bring it back as a new entry."
	>
		<input type="hidden" name="csrf" value={ csrf }/>
		<button class="linkish danger" type="submit">Delete reading history</button>
	</form>
}

// libraryTable is the same rows for the times when scanning five
// thousand titles beats looking at five thousand pictures.
templ libraryTable(prefix, csrf string, v LibraryView) {
	<table>
		<thead>
			<tr><th scope="col"></th><th scope="col">Title</th><th scope="col">Progress</th><th scope="col">Last read</th><th scope="col">Added</th><th scope="col"></th></tr>
		</thead>
		for _, row := range v.Rows {
			<tr>
				<td>
					if row.BookID != "" {
						<a href={ row.href(prefix) }>
							<img
								class="cover-thumb"
								src={ prefix + "books/" + row.BookID + "/cover?size=thumbnail" }
								alt=""
								loading="lazy"
								width="40"
								height="60"
							/>
						</a>
					}
				</td>
				<td>
					<a href={ row.href(prefix) }>{ orPlaceholder(row.Title) }</a>
					if row.Pending {
						<span class="muted">pending</span>
					}
					if row.Author != "" {
						<span class="by">{ row.Author }</span>
					}
				</td>
				<td>
					if row.Progression != nil {
						@progressBar("bar", *row.Progression)
						{ pctProgression(*row.Progression) }
					} else {
						<span class="muted">—</span>
					}
				</td>
				<td>{ orDash(row.LastActive) }</td>
				<td>{ orDash(row.Added) }</td>
				<td>
					<a href={ row.detailURL(prefix) }>Details</a>
					if row.BookID != "" {
						@markBookForm(prefix, csrf, row.BookID, row.Finished())
					}
					if row.Bookless {
						@deleteWorkForm(prefix, csrf, row.WorkID, "closest tr")
					}
				</td>
			</tr>
		}
	</table>
	if v.NextURL != "" {
		<p><a rel="next" href={ v.NextURL }>Next page</a></p>
	}
}

// uploadDialog sends books to the selected folder (ADR-0023). It appears
// only where an administrator asked for that folder to be writable.
//
// The CSRF token goes in the action's query string rather than in a
// hidden field, because the handler has to check it before the body is
// read and the body is a whole book: a field would mean buffering the
// upload to find the token that says whether to accept the upload.
templ uploadDialog(prefix, csrf, folder string) {
	<dialog id="upload-dialog" class="upload-dialog folder-dialog" aria-labelledby="upload-dialog-title">
		<div class="dialog-head">
			<div>
				<h2 id="upload-dialog-title">Upload books</h2>
			</div>
			<form method="dialog">
				<button type="submit" class="dialog-close" aria-label="Close">✕</button>
			</form>
		</div>
		<form
			id="upload-dialog-form"
			class="upload-dialog-form upload"
			method="post"
			enctype="multipart/form-data"
			action={ prefix + "library/upload?folder=" + folder + "&csrf=" + csrf }
		>
			<label for="upload-dialog-file" class="upload-dropzone" id="upload-dropzone">
				<span class="upload-dropzone-glyph" aria-hidden="true">@uiIcon("Upload")</span>
				<p class="upload-dropzone-prompt">
					<strong>Drop EPUB files here</strong> or <span class="upload-browse-link">browse files</span>
				</p>
				<p class="upload-dropzone-hint muted">Select one or multiple .epub books</p>
				<input
					id="upload-dialog-file"
					class="visually-hidden"
					type="file"
					name="file"
					accept=".epub,application/epub+zip"
					multiple
					required
				/>
			</label>
			<div class="upload-queue" id="upload-queue" hidden>
				<div class="upload-queue-head">
					<span class="upload-queue-count muted" id="upload-queue-count"></span>
					<button type="button" class="btn linkish upload-queue-clear" id="upload-queue-clear">Clear all</button>
				</div>
				<ul class="upload-queue-list" id="upload-queue-list"></ul>
			</div>
			<div class="upload-dialog-actions">
				<button type="submit" id="upload-dialog-submit" class="btn primary">Send a book</button>
				<span class="uploadstatus muted" role="status"></span>
			</div>
		</form>
	</dialog>
}

// refreshButton is the pull gesture said with a pointer: deliver what
// this browser read offline, then draw the shelf the server has now.
//
// It is not the Scan button beside it and does not do its work. Scan
// asks the server to walk its folders and look at the disk; this asks
// nothing of the disk at all. A reader who has just read a chapter on
// their phone wants this one.
//
// Served hidden, because with no script running it would be a control
// that does nothing. library-refresh.js reveals it.
templ refreshButton() {
	<button
		type="button"
		class="refreshbtn"
		data-refresh
		title="Sync and refresh this shelf"
		aria-label="Sync and refresh this shelf"
		hidden
	>
		<svg class="ui-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
			<path d="M21 3v6h-6"></path>
		</svg>
		<span class="refreshlabel">Refresh</span>
	</button>
}

// scanButton asks for a pass over the libraries this reader can see and
// waits for it, so the shelf that comes back is the one the pass made.
//
// back is where to land afterwards, written the way this page would
// write it — relative, so it survives a proxy serving the UI under a
// subpath, and carrying the folder, filter and sort the reader had.
templ scanButton(prefix, csrf, back string) {
	<form
		class="scanform"
		method="post"
		action={ prefix + "library/scan" }
		hx-post={ prefix + "library/scan" }
		hx-disabled-elt="find button"
	>
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="back" value={ back }/>
		<button type="submit" class="scanbtn" title="Scan for new books">
			<span class="scanicon" aria-hidden="true">↻</span>
			<span class="scanlabel">Scan</span>
			<span class="scanspinner" aria-hidden="true"></span>
		</button>
		// ui.js announces the wait here; the spinner is aria-hidden, so
		// without this a screen reader hears nothing for up to a minute.
		<span class="scansay visually-hidden" role="status"></span>
	</form>
}
