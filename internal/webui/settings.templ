package webui

templ settingsPage(prefix string, u userCtx, csrf string, v settingsView) {
	{{ title := "Settings" }}
	if v.Section == settingsAdmin && v.Admin.View == settingsAdminFolders {
		{{ title = "Folders" }}
	}
	@layout(title, prefix, u, csrf, settingsBody(prefix, u, csrf, v))
}

templ settingsBody(prefix string, u userCtx, csrf string, v settingsView) {
	// The Folders page brings its own heading and its own actions, so the
	// shared one would only repeat it. The tabs and the admin subnav stay:
	// a page reached from Administration belongs to it.
	if v.Section != settingsAdmin || v.Admin.View != settingsAdminFolders {
		<header class="settings-heading">
			<h1>Settings</h1>
		</header>
	}
	<nav class="settings-tabs" aria-label="Settings sections">
		@settingsTab(settingsHref(prefix, settingsProfile), "Profile & security", v.Section == settingsProfile)
		@settingsTab(settingsHref(prefix, settingsDevices), "Devices & integrations", v.Section == settingsDevices)
		if u.IsAdmin {
			@settingsTab(settingsHref(prefix, settingsAdmin), "Administration", v.Section == settingsAdmin)
		}
	</nav>
	if v.Section == settingsDevices {
		@devicesBody(prefix, u, csrf, v.Devices.View, v.Devices.Tokens, v.Devices.Browsers,
			v.Devices.Kosync, v.Devices.Koplugin, v.Devices.Base, v.Flash)
	} else if v.Section == settingsAdmin {
		@settingsAdminBody(prefix, csrf, v)
	} else {
		@settingsProfileBody(prefix, u, csrf, v)
	}
}

templ settingsTab(href string, label string, current bool) {
	if current {
		<a href={ href } aria-current="page">{ label }</a>
	} else {
		<a href={ href }>{ label }</a>
	}
}

templ settingsProfileBody(prefix string, u userCtx, csrf string, v settingsView) {
	<section class="card settings-card">
		<h2>Profile</h2>
		<p class="muted">Choose how reading activity is recorded for your account.</p>
		if v.Flash.Error != "" {
			<p class="error">{ v.Flash.Error }</p>
		}
		if v.Saved {
			<p class="ok">Saved.</p>
		}
		<form method="post" action={ prefix + "settings" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<label>Timezone
				<select name="timezone">
					for _, z := range v.Zones {
						if z == u.User.Timezone {
							<option value={ z } selected>{ z }</option>
						} else {
							<option value={ z }>{ z }</option>
						}
					}
				</select>
			</label>
			<fieldset>
				<legend>Adapters</legend>
				<label class="check">
					if u.User.KosyncEnabled {
						<input type="checkbox" name="kosync_enabled" checked/>
					} else {
						<input type="checkbox" name="kosync_enabled"/>
					}
					kosync (stock KOReader position sync)
				</label>
				<label class="check">
					if u.User.KopluginEnabled {
						<input type="checkbox" name="koplugin_enabled" checked/>
					} else {
						<input type="checkbox" name="koplugin_enabled"/>
					}
					statistics plugin (koplugin)
				</label>
			</fieldset>
			<fieldset>
				<legend>Reader prompt</legend>
				<p class="muted">
					Highlight a passage in the web reader and a button copies this
					text to your clipboard with the placeholders filled in, ready
					to paste into an assistant. Leave it empty and no button
					appears.
				</p>
				<label>
					Prompt
					<textarea name="reader_prompt" rows="9" maxlength={ readerPromptMaxLength() } id="reader-prompt-template" spellcheck="true">{ u.User.ReaderPromptTemplate }</textarea>
				</label>
				<p class="muted">
					Placeholders: { readerPromptPlaceholders }. A placeholder this
					book has no answer for is left blank; anything else in braces
					is kept as you wrote it.
				</p>
				<button
					type="button"
					class="prompt-example"
					data-prompt-target="reader-prompt-template"
					data-prompt={ readerPromptExample }
				>Use the example prompt</button>
			</fieldset>
			<button type="submit" class="primary">Save profile</button>
		</form>
	</section>
	<section class="card settings-card">
		<h2>Change password</h2>
		<p class="muted">Changing it signs out your other web sessions.</p>
		if v.PasswordMessage != "" {
			if v.PasswordError {
				<p class="error">{ v.PasswordMessage }</p>
			} else {
				<p class="ok">{ v.PasswordMessage }</p>
			}
		}
		<form method="post" action={ prefix + "settings/password" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<label>Current password <input name="current" type="password" required autocomplete="current-password"/></label>
			<label>New password <input name="new" type="password" required minlength="8" autocomplete="new-password"/></label>
			<label>Repeat new password <input name="repeat" type="password" required minlength="8" autocomplete="new-password"/></label>
			<button type="submit" class="primary">Change password</button>
		</form>
	</section>
	<section class="card settings-card">
		<h2>Export library</h2>
		<p class="muted">Export your book list and reading status as a CSV file to preview, copy, or download.</p>
		// The export is a link to a file first and a preview second:
		// with no script it downloads, and the module only turns it
		// into a dialog with the same text in it.
		<a
			class="btn csvbtn"
			href={ prefix + "library.csv?filter=all" }
			data-csv-open="csv-dialog"
			aria-haspopup="dialog"
			aria-controls="csv-dialog"
		>
			<span class="csv-icon" aria-hidden="true">@uiIcon("Export")</span>
			<span>Export as CSV</span>
		</a>
	</section>
	@csvDialog(prefix, "library.csv?filter=all")
}

// csvDialog is the export's preview: the file itself, in a box big enough
// to read, with the two things somebody opens a CSV to do to it — copy it
// here, or take it away.
//
// The text arrives from the module rather than baked into the page, so a
// reader who never opens this dialog never pays for the whole shelf being
// serialized twice. Without the module the textarea stays a promise and
// the Download link below it is still the real thing.
templ csvDialog(prefix, exportURL string) {
	<dialog id="csv-dialog" class="folder-dialog csv-dialog" aria-labelledby="csv-dialog-title">
		<div class="dialog-head">
			<div>
				<h2 id="csv-dialog-title">Export as CSV</h2>
				<p class="csv-hint" data-csv-hint>One row per book across your library.</p>
			</div>
			<form method="dialog">
				<button type="submit" class="dialog-close" aria-label="Close">✕</button>
			</form>
		</div>
		<textarea
			id="csv-text"
			class="csv-text"
			placeholder="Loading…"
			readonly
			spellcheck="false"
			rows="14"
			aria-label="The CSV file"
		></textarea>
		<div class="csv-actions">
			<button type="button" class="btn" data-csv-copy disabled>Copy</button>
			<a class="btn" href={ prefix + exportURL } download="library.csv">Download</a>
			<span class="muted csv-status" data-csv-status role="status"></span>
		</div>
	</dialog>
}

templ settingsAdminBody(prefix string, csrf string, v settingsView) {
	<nav class="settings-subnav" aria-label="Administration sections">
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminOverview), "Overview", v.Admin.View == settingsAdminOverview)
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminUsers), "Users", v.Admin.View == settingsAdminUsers || v.Admin.View == settingsAdminUser)
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminFolders), "Folders", v.Admin.View == settingsAdminFolders)
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminMirror), "Mirror", v.Admin.View == settingsAdminMirror)
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminAudiobookshelf), "Audiobookshelf", v.Admin.View == settingsAdminAudiobookshelf)
		@settingsAdminTab(settingsAdminHref(prefix, settingsAdminSpeechToText), "Speech-to-text", v.Admin.View == settingsAdminSpeechToText)
	</nav>
	if v.Admin.View == settingsAdminFolders {
		@adminFoldersBody(prefix, csrf, v.Admin.Folders, v.Admin.HasFolders, v.Admin.FoldersNext, v.Admin.Roots, v.Admin.OpenFolderForm, v.Flash)
	} else if v.Admin.View == settingsAdminUsers {
		@adminUsersBody(prefix, csrf, v.Admin.Users, v.Admin.UsersNext, v.Admin.Invites, v.Admin.Create, v.Flash)
	} else if v.Admin.View == settingsAdminUser && v.Admin.HasUser {
		@adminUserBody(prefix, csrf, v.Admin.User, v.Flash)
	} else if v.Admin.View == settingsAdminMirror {
		@adminMirrorBody(prefix, csrf, v.Admin.Mirror, v.Flash)
	} else if v.Admin.View == settingsAdminAudiobookshelf {
		@adminAudiobookshelfBody(prefix, csrf, v.Admin.AudiobookshelfPanel, v.Flash)
	} else if v.Admin.View == settingsAdminSpeechToText {
		@adminSpeechToTextBody(prefix, csrf, v.Admin.SpeechToText, v.Flash)
	} else {
		@adminFlash(v.Flash)
		@adminOverviewBody(prefix, v.Admin)
	}
}

templ settingsAdminTab(href string, label string, current bool) {
	if current {
		<a href={ href } aria-current="page">{ label }</a>
	} else {
		<a href={ href }>{ label }</a>
	}
}
