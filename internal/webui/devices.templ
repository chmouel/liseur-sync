package webui

import "github.com/chmouel/liseur-sync/internal/store"

// Devices page: tokens, kosync slots, koplugin capabilities, pairing.

templ devicesPage(prefix string, u userCtx, csrf string, toks []store.Token, kosyncDevs []store.KosyncDevice, kopluginDevs []store.KopluginDevice, base string, flash Flash) {
	@layout("Devices", prefix, u, csrf, devicesBody(prefix, csrf, toks, kosyncDevs, kopluginDevs, base, flash))
}

// Flash carries one-time results (a shown-once secret).
type Flash struct {
	Secret      string
	SecretLabel string
	Notice      string
	// Error is a refusal the reader has to read: a wrong password, a
	// name already taken, a guard that fired. It renders in the danger
	// colour above the page's forms.
	Error string
}

templ devicesBody(prefix string, csrf string, toks []store.Token, kosyncDevs []store.KosyncDevice, kopluginDevs []store.KopluginDevice, base string, flash Flash) {
	<h1>Devices</h1>
	if flash.Secret != "" {
		<div class="card secret">
			<p><b>{ flash.SecretLabel }</b> (shown once):</p>
			<code class="big">{ flash.Secret }</code>
		</div>
	}
	if flash.Notice != "" {
		<p class="ok">{ flash.Notice }</p>
	}

	<section class="card">
		<h2>API tokens</h2>
		<table>
			<tr><th>Name</th><th>Type</th><th>Scopes</th><th>Device id</th><th>State</th><th></th></tr>
			for _, t := range toks {
				{{ devType := detectDeviceType(t.Name, t.DeviceID) }}
				<tr>
					<td>
						<span class="dev-cell">
							@deviceIcon(devType)
							<span>{ t.Name }</span>
						</span>
					</td>
					<td><span class="muted">{ deviceTypeLabel(devType) }</span></td>
					<td>
						if t.RevokedAt == nil && !hasScope(t.Scopes, store.ScopeAdmin) {
							<form method="post" action={ prefix + "tokens/" + t.ID + "/scopes" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								@scopeChoice(store.ScopeSync, hasScope(t.Scopes, store.ScopeSync))
								@scopeChoice(store.ScopeReadInsights, hasScope(t.Scopes, store.ScopeReadInsights))
								@scopeChoice(store.ScopeLibraryRead, hasScope(t.Scopes, store.ScopeLibraryRead))
								<button type="submit">Update</button>
							</form>
						} else {
							{ formatScopes(t.Scopes) }
						}
					</td>
					<td><code>{ t.DeviceID }</code></td>
					<td>
						if t.RevokedAt != nil {
							<span class="muted">revoked</span>
						} else {
							active
						}
					</td>
					<td>
						if t.RevokedAt == nil {
							<form method="post" action={ prefix + "tokens/" + t.ID + "/revoke" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								<button type="submit" class="danger">Revoke</button>
							</form>
						}
					</td>
				</tr>
			}
		</table>
		<form method="post" action={ prefix + "tokens" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<input name="name" placeholder="Boox Palma" required/>
			@scopeChoice(store.ScopeSync, true)
			@scopeChoice(store.ScopeReadInsights, false)
			@scopeChoice(store.ScopeLibraryRead, false)
			<button type="submit" class="primary">New token</button>
		</form>
	</section>

	<section class="card">
		<h2>KOReader (kosync)</h2>
		<p class="muted">
			Generate a pairing code, then in KOReader's kosync settings:
			username = device name, password = code, server =
			<code>{ base + "/adapter/kosync" }</code>.
		</p>
		<form method="post" action={ prefix + "pairing" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<button type="submit">Generate pairing code</button>
		</form>
		if len(kosyncDevs) > 0 {
			<table>
				<tr><th>Slot</th><th>Label</th><th>Type</th><th>State</th><th></th></tr>
				for _, d := range kosyncDevs {
					{{ devType := detectDeviceType(d.Label, d.DeviceSlot) }}
					<tr>
						<td><code>{ d.DeviceSlot }</code></td>
						<td>
							<span class="dev-cell">
								@deviceIcon(devType)
								<span>{ d.Label }</span>
							</span>
						</td>
						<td><span class="muted">{ deviceTypeLabel(devType) }</span></td>
						<td>
							if d.RevokedAt != nil {
								<span class="muted">revoked</span>
							} else {
								active
							}
						</td>
						<td>
							if d.RevokedAt == nil {
								<form method="post" action={ prefix + "kosync/" + d.DeviceSlot + "/revoke" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<button type="submit" class="danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</table>
		}
	</section>

	<section class="card">
		<h2>KOReader statistics plugin</h2>
		<p class="muted">
			Point the plugin's server at
			<code>{ base + "/adapter/koplugin/<capability>" }</code>.
		</p>
		<form method="post" action={ prefix + "koplugin" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<input name="name" placeholder="Kobo Clara" required/>
			<button type="submit" class="primary">New capability</button>
		</form>
		if len(kopluginDevs) > 0 {
			<table>
				<tr><th>Name</th><th>Type</th><th>Device id</th><th>State</th><th></th></tr>
				for _, d := range kopluginDevs {
					{{ devType := detectDeviceType(d.Label, d.DeviceID) }}
					<tr>
						<td>
							<span class="dev-cell">
								@deviceIcon(devType)
								<span>{ d.Label }</span>
							</span>
						</td>
						<td><span class="muted">{ deviceTypeLabel(devType) }</span></td>
						<td><code>{ d.DeviceID }</code></td>
						<td>
							if d.RevokedAt != nil {
								<span class="muted">revoked</span>
							} else {
								active
							}
						</td>
						<td>
							if d.RevokedAt == nil {
								<form method="post" action={ prefix + "koplugin/" + d.ID + "/revoke" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<button type="submit" class="danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</table>
		}
	</section>

	<section class="card">
		<h2>OPDS catalog</h2>
		<p class="muted">
			The address to give a reading app that browses catalogs —
			KOReader, Moon+ Reader, KyBook, Thorium and most others. It
			serves the same books as the Library page.
		</p>
		<p><code class="big">{ base + "/opds/v1.2" }</code></p>
		<p class="muted">
			When it asks for a login, the password is an API token secret
			from above — not your account password, which the catalog does
			not accept. The username is that token's name — or the word
			<code>token</code>, for an app that insists on one it can
			remember. The token needs the
			<code>{ string(store.ScopeLibraryRead) }</code> scope; one
			without it can sync positions but cannot see a book.
		</p>
	</section>
}

templ deviceIcon(devType string) {
	<span class={ "dev-icon", "dev-" + devType } title={ deviceTypeLabel(devType) } aria-label={ deviceTypeLabel(devType) }>
		if devType == DeviceWeb {
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
		} else if devType == DeviceMobile {
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
		} else if devType == DeviceEReader {
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
		} else {
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
		}
	</span>
}

templ scopeChoice(scope store.Scope, checked bool) {
	<label class="check">
		if checked {
			<input type="checkbox" name="scopes" value={ string(scope) } checked/>
		} else {
			<input type="checkbox" name="scopes" value={ string(scope) }/>
		}
		{ string(scope) }
	</label>
}
