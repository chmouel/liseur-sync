package webui

import "github.com/chmouel/liseur-sync/internal/store"

// Devices page: tokens, kosync slots, koplugin capabilities, pairing.

templ devicesPage(prefix string, u userCtx, csrf string, toks []store.Token, kosyncDevs []store.KosyncDevice, kopluginDevs []store.KopluginDevice, flash Flash) {
	@layout("Devices", prefix, u, csrf, devicesBody(prefix, csrf, toks, kosyncDevs, kopluginDevs, flash))
}

// Flash carries one-time results (a shown-once secret).
type Flash struct {
	Secret      string
	SecretLabel string
	Notice      string
}

templ devicesBody(prefix string, csrf string, toks []store.Token, kosyncDevs []store.KosyncDevice, kopluginDevs []store.KopluginDevice, flash Flash) {
	<h1>Devices</h1>
	if flash.Secret != "" {
		<div class="card secret">
			<p><b>{ flash.SecretLabel }</b> (shown once):</p>
			<code class="big">{ flash.Secret }</code>
		</div>
	}
	if flash.Notice != "" {
		<p class="ok">{ flash.Notice }</p>
	}

	<section class="card">
		<h2>API tokens</h2>
		<table>
			<tr><th>Name</th><th>Scopes</th><th>Device id</th><th>State</th><th></th></tr>
			for _, t := range toks {
				<tr>
					<td>{ t.Name }</td>
					<td>
						if t.RevokedAt == nil && !hasScope(t.Scopes, store.ScopeAdmin) {
							<form method="post" action={ prefix + "tokens/" + t.ID + "/scopes" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								@scopeChoice(store.ScopeSync, hasScope(t.Scopes, store.ScopeSync))
								@scopeChoice(store.ScopeReadInsights, hasScope(t.Scopes, store.ScopeReadInsights))
								@scopeChoice(store.ScopeLibraryRead, hasScope(t.Scopes, store.ScopeLibraryRead))
								@scopeChoice(store.ScopeLibraryManage, hasScope(t.Scopes, store.ScopeLibraryManage))
								<button type="submit">Update</button>
							</form>
						} else {
							{ formatScopes(t.Scopes) }
						}
					</td>
					<td><code>{ t.DeviceID }</code></td>
					<td>
						if t.RevokedAt != nil {
							<span class="muted">revoked</span>
						} else {
							active
						}
					</td>
					<td>
						if t.RevokedAt == nil {
							<form method="post" action={ prefix + "tokens/" + t.ID + "/revoke" }>
								<input type="hidden" name="csrf" value={ csrf }/>
								<button type="submit" class="danger">Revoke</button>
							</form>
						}
					</td>
				</tr>
			}
		</table>
		<form method="post" action={ prefix + "tokens" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<input name="name" placeholder="Boox Palma" required/>
			@scopeChoice(store.ScopeSync, true)
			@scopeChoice(store.ScopeReadInsights, false)
			@scopeChoice(store.ScopeLibraryRead, false)
			@scopeChoice(store.ScopeLibraryManage, false)
			<button type="submit" class="primary">New token</button>
		</form>
	</section>

	<section class="card">
		<h2>KOReader (kosync)</h2>
		<p class="muted">Generate a pairing code, then in KOReader's kosync settings: username = device name, password = code, server = <code>https://&lt;host&gt;/adapter/kosync</code>.</p>
		<form method="post" action={ prefix + "pairing" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<button type="submit">Generate pairing code</button>
		</form>
		if len(kosyncDevs) > 0 {
			<table>
				<tr><th>Slot</th><th>Label</th><th>State</th><th></th></tr>
				for _, d := range kosyncDevs {
					<tr>
						<td><code>{ d.DeviceSlot }</code></td>
						<td>{ d.Label }</td>
						<td>
							if d.RevokedAt != nil {
								<span class="muted">revoked</span>
							} else {
								active
							}
						</td>
						<td>
							if d.RevokedAt == nil {
								<form method="post" action={ prefix + "kosync/" + d.DeviceSlot + "/revoke" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<button type="submit" class="danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</table>
		}
	</section>

	<section class="card">
		<h2>KOReader statistics plugin</h2>
		<p class="muted">Point the plugin's server at <code>https://&lt;host&gt;/adapter/koplugin/&lt;capability&gt;</code>.</p>
		<form method="post" action={ prefix + "koplugin" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<input name="name" placeholder="Kobo Clara" required/>
			<button type="submit" class="primary">New capability</button>
		</form>
		if len(kopluginDevs) > 0 {
			<table>
				<tr><th>Name</th><th>Device id</th><th>State</th><th></th></tr>
				for _, d := range kopluginDevs {
					<tr>
						<td>{ d.Label }</td>
						<td><code>{ d.DeviceID }</code></td>
						<td>
							if d.RevokedAt != nil {
								<span class="muted">revoked</span>
							} else {
								active
							}
						</td>
						<td>
							if d.RevokedAt == nil {
								<form method="post" action={ prefix + "koplugin/" + d.ID + "/revoke" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<button type="submit" class="danger">Revoke</button>
								</form>
							}
						</td>
					</tr>
				}
			</table>
		}
	</section>
}

templ scopeChoice(scope store.Scope, checked bool) {
	<label class="check">
		if checked {
			<input type="checkbox" name="scopes" value={ string(scope) } checked/>
		} else {
			<input type="checkbox" name="scopes" value={ string(scope) }/>
		}
		{ string(scope) }
	</label>
}
