package webui

import "github.com/chmouel/liseur-sync/internal/store"

// Works library + per-work pages.

type WorkRow struct {
	ID          string
	BookID      string
	Title       string
	Author      string
	Progression *float64
	LastActive  string
	Pending     bool
	// CanRead is set when the mapped catalog book has an EPUB the
	// browser could open, which is what makes the cover a "carry on
	// reading" link rather than a link to the statistics.
	CanRead bool
}

// readURL is where a work's cover goes: back into the book when there is
// one to open, and to the work's own page otherwise. Picking the book up
// again is what a reader clicking their own shelf almost always means;
// the numbers are a sublink away.
func (w WorkRow) readURL(prefix string) string {
	if w.CanRead && w.BookID != "" {
		return prefix + "books/" + w.BookID + "/read"
	}
	return prefix + "works/" + w.ID
}

// workCardHint says what the cover will do, since it does two different
// things depending on whether there is a file here to open.
func workCardHint(w WorkRow) string {
	if w.CanRead && w.BookID != "" {
		return "Continue reading " + orPlaceholder(w.Title)
	}
	return orPlaceholder(w.Title)
}

type WorkDetail struct {
	Work        store.Work
	Minutes     float64
	Pages       float64
	Sessions    int
	CurrentProg float64
	ETAHuman    string
	// BookID and CanRead are the catalog book this work is mapped to,
	// when there is one, so the page that shows the numbers can also be
	// the way back into the book.
	BookID  string
	CanRead bool
}

type OpRow struct {
	When        string
	DeviceID    string
	Origin      string
	Progression float64
	ForeignPos  string
}

templ workPage(prefix string, u userCtx, csrf string, d WorkDetail, ops []OpRow, sessions []SessionRow) {
	@layout(orPlaceholder(d.Work.Title), prefix, u, csrf, workBody(prefix, csrf, d, ops, sessions))
}

templ workBody(prefix, csrf string, d WorkDetail, ops []OpRow, sessions []SessionRow) {
	<h1>{ orPlaceholder(d.Work.Title) }</h1>
	if d.Work.Author != "" {
		<p class="muted">{ d.Work.Author }</p>
	}
	if d.BookID != "" {
		<p class="rowlinks">
			if d.CanRead {
				<a class="btn primary" href={ prefix + "books/" + d.BookID + "/read" }>Read</a>
			}
			<a class="btn" href={ prefix + "books/" + d.BookID }>Book details</a>
		</p>
	}
	<section class="cards" id="stats">
		<div class="stat"><span class="num">{ pct(d.CurrentProg) }</span><span class="lbl">read</span></div>
		<div class="stat"><span class="num">{ f0(d.Minutes) }</span><span class="lbl">minutes</span></div>
		if d.Pages > 0 {
			<div class="stat"><span class="num">{ f0(d.Pages) }</span><span class="lbl">pages</span></div>
		}
		<div class="stat"><span class="num">{ i2s(d.Sessions) }</span><span class="lbl">sessions</span></div>
		if d.ETAHuman != "" {
			<div class="stat"><span class="num">{ d.ETAHuman }</span><span class="lbl">left (est.)</span></div>
		}
	</section>
	// The sessions this work still has in full. Older ones have been
	// rolled up into daily totals (they are counted in the statistics
	// above but no longer exist one by one), which is why this list can
	// be shorter than the session count.
	<section class="card" id="sessions">
		<h2>Sessions</h2>
		if len(sessions) == 0 {
			<p class="muted">No sessions recorded yet — they appear once a device reports reading time.</p>
		} else {
			<table>
				<tr><th>When</th><th>Device</th><th>Duration</th><th>Progress</th></tr>
				for _, s := range sessions {
					<tr>
						<td>{ s.When }</td>
						<td><code>{ s.DeviceID }</code></td>
						<td>{ i2s(s.Minutes) } min</td>
						<td>{ pct(s.StartProg) } → { pct(s.EndProg) }</td>
					</tr>
				}
			</table>
		}
	</section>
	<section class="card">
		<h2>Position history</h2>
		<p class="muted">Newest first — the operation log makes a mis-synced position recoverable.</p>
		if len(ops) == 0 {
			<p class="muted">No positions recorded yet.</p>
		} else {
			<table>
				<tr><th>When</th><th>Device</th><th>Via</th><th>Progress</th></tr>
				for _, o := range ops {
					<tr>
						<td>{ o.When }</td>
						<td><code>{ o.DeviceID }</code></td>
						<td>{ o.Origin }</td>
						<td>{ pct(o.Progression) }</td>
					</tr>
				}
			</table>
		}
	</section>
	// A work no book on this server backs is the reader's to forget:
	// it is reading state about a file that is somewhere else, or
	// nowhere. A work with a book keeps its history with the book, even
	// when the file is missing, so this section is simply not here
	// (ADR-0024).
	if d.BookID == "" {
		<section class="card">
			<h2>Delete</h2>
			<p class="muted">
				This server holds no file for this book — the reading came
				from a device. Deleting it removes these positions, these
				sessions and the statistics above, for this account only.
				A device still syncing this book will bring it back as a new
				entry, starting from wherever that device is now.
			</p>
			<form
				method="post"
				action={ prefix + "works/" + d.Work.ID + "/delete" }
				hx-confirm="Delete this book's reading history? A device still syncing this book will bring it back as a new entry."
			>
				<input type="hidden" name="csrf" value={ csrf }/>
				<button class="danger" type="submit">Delete reading history</button>
			</form>
		</section>
	}
}
