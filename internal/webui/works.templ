package webui

import "github.com/chmouel/liseur-sync/internal/store"

// Works library + per-work pages.

type WorkRow struct {
	ID          string
	BookID      string
	Title       string
	Subtitle    string
	Author      string
	Progression *float64
	LastActive  string
	Pending     bool
	// CanRead is set when the mapped catalog book has an EPUB the
	// browser could open, which is what makes the cover a "carry on
	// reading" link rather than a link to the statistics.
	CanRead bool
}

// readURL is where a work's cover goes: back into the book when there is
// one to open, and to the work's own page otherwise. Picking the book up
// again is what a reader clicking their own shelf almost always means;
// the numbers are a sublink away.
func (w WorkRow) readURL(prefix string) string {
	if w.CanRead && w.BookID != "" {
		return prefix + "books/" + w.BookID + "/read"
	}
	return prefix + "works/" + w.ID
}

// workCardHint says what the cover will do, since it does two different
// things depending on whether there is a file here to open.
func workCardHint(w WorkRow) string {
	if w.CanRead && w.BookID != "" {
		return "Continue reading " + orPlaceholder(w.Title)
	}
	return orPlaceholder(w.Title)
}

type WorkDetail struct {
	Work        store.Work
	Duration    string
	Pages       float64
	Sessions    int
	Sittings    string
	CurrentProg float64
	ETAHuman    string
	// Started, ReadingFor and LastRead are the shape of the reading
	// rather than its size: when it began, how long it has been going
	// on, and when it was last picked up.
	Started    string
	ReadingFor string
	LastRead   string
	// BookID and CanRead are the catalog book this work is mapped to,
	// when there is one, so the page that shows the numbers can also be
	// the way back into the book.
	BookID  string
	CanRead bool
}

type OpRow struct {
	When        string
	DeviceID    string
	Origin      string
	Progression float64
	ForeignPos  string
}

// AnnotationRow is one annotation on the work page (ADR-0028): the
// excerpt and the reader's own words, rendered as text — never markup
// — with the where and when beside them.
type AnnotationRow struct {
	Kind    string
	Color   string
	Excerpt string
	Body    string
	Where   string
	When    string
}

// annColorClass maps a stored palette token to a fixed CSS class. The
// token was validated at write time, but the class list is still a
// closed table here: nothing from the wire names a style.
func annColorClass(color string) string {
	switch color {
	case "yellow", "green", "blue", "pink", "purple", "orange":
		return "ann-color-" + color
	}
	return ""
}

templ workPage(prefix string, u userCtx, csrf string, d WorkDetail, ops []OpRow, sessions []SessionRow, anns []AnnotationRow) {
	@layout(orPlaceholder(d.Work.Title), prefix, u, csrf, workBody(prefix, csrf, d, ops, sessions, anns))
}

templ workBody(prefix, csrf string, d WorkDetail, ops []OpRow, sessions []SessionRow, anns []AnnotationRow) {
	<h1>{ orPlaceholder(d.Work.Title) }</h1>
	if d.Work.Author != "" {
		<p class="muted">{ d.Work.Author }</p>
	}
	if d.BookID != "" {
		<p class="rowlinks">
			if d.CanRead {
				<a class="btn primary" href={ prefix + "books/" + d.BookID + "/read" }>Read</a>
			}
			<a class="btn" href={ prefix + "books/" + d.BookID }>Book details</a>
		</p>
	}
	<section class="cards" id="stats">
		<div class="stat"><span class="stat-icon">@uiIcon("Library")</span><span class="num">{ pct(d.CurrentProg) }</span><span class="lbl">read</span></div>
		<div class="stat"><span class="stat-icon">@uiIcon("Minutes")</span><span class="num words">{ d.Duration }</span><span class="lbl">time spent reading</span></div>
		if d.Pages > 0 {
			<div class="stat"><span class="stat-icon">@uiIcon("Pages")</span><span class="num">{ f0(d.Pages) }</span><span class="lbl">pages</span></div>
		}
		<div class="stat"><span class="stat-icon">@uiIcon("Sessions")</span><span class="num">{ i2s(d.Sessions) }</span><span class="lbl">sittings</span></div>
		if d.Started != "" {
			<div class="stat"><span class="stat-icon">@uiIcon("Calendar")</span><span class="num words">{ d.Started }</span><span class="lbl">started</span></div>
		}
		if d.ReadingFor != "" {
			<div class="stat"><span class="stat-icon">@uiIcon("Span")</span><span class="num words">{ d.ReadingFor }</span><span class="lbl">reading for</span></div>
		}
		if d.LastRead != "" {
			<div class="stat"><span class="stat-icon">@uiIcon("Calendar")</span><span class="num words">{ d.LastRead }</span><span class="lbl">last read</span></div>
		}
	</section>
	if d.ETAHuman != "" {
		<p class="work-eta">
			<span class="work-eta-icon">@uiIcon("Pace")</span>
			{ "About " + d.ETAHuman + " left, at the pace you have been reading" }
		</p>
	}
	// Highlights and notes synced from the reader's devices (ADR-0028),
	// view-only here. Each links back into the book when the viewer's
	// folder grants reach one to open; otherwise it is simply listed.
	if len(anns) > 0 {
		<section class="card" id="annotations">
			<h2>Annotations</h2>
			<ul class="annlist">
				for _, an := range anns {
					<li>
						<span class={ "ann-kind", annColorClass(an.Color) }>{ an.Kind }</span>
						if an.Excerpt != "" {
							<blockquote class="ann-excerpt">{ an.Excerpt }</blockquote>
						}
						if an.Body != "" {
							<p class="ann-body">{ an.Body }</p>
						}
						<span class="muted small">
							{ an.When }
							if an.Where != "" {
								&nbsp;·&nbsp;{ an.Where }
							}
						</span>
						if d.CanRead && d.BookID != "" {
							<a class="small" href={ prefix + "books/" + d.BookID + "/read" }>Open in reader</a>
						}
					</li>
				}
			</ul>
		</section>
	}
	// The sessions this work still has in full. Older ones have been
	// rolled up into daily totals (they are counted in the statistics
	// above but no longer exist one by one), which is why this list can
	// be shorter than the session count.
	<section class="card" id="sessions">
		<h2>Sessions</h2>
		if len(sessions) == 0 && d.Sessions == 0 {
			<p class="muted">You have not read any of this one yet.</p>
		} else if len(sessions) == 0 {
			// Every sitting has aged into a daily total. The reading
			// happened and is counted above; it is the sitting-by-sitting
			// record that is gone, and saying nothing was read would
			// contradict the totals on the same page.
			<p class="muted">No individual sittings are kept for this one any more. The totals above still count them.</p>
		} else {
			<table>
				<tr><th>When</th><th>Device</th><th>Duration</th><th>Progress</th></tr>
				for _, s := range sessions {
					<tr>
						<td>{ s.When }</td>
						<td><code>{ s.DeviceID }</code></td>
						<td>{ s.Duration }</td>
						<td>{ pct(s.StartProg) } → { pct(s.EndProg) }</td>
					</tr>
				}
			</table>
		}
	</section>
	<section class="card">
		<h2>Position history</h2>
		<p class="muted">Newest first — the operation log makes a mis-synced position recoverable.</p>
		if len(ops) == 0 {
			<p class="muted">No positions recorded yet.</p>
		} else {
			<table>
				<tr><th>When</th><th>Device</th><th>Via</th><th>Progress</th></tr>
				for _, o := range ops {
					<tr>
						<td>{ o.When }</td>
						<td><code>{ o.DeviceID }</code></td>
						<td>{ o.Origin }</td>
						<td>{ pct(o.Progression) }</td>
					</tr>
				}
			</table>
		}
	</section>
	// A work no book on this server backs is the reader's to forget:
	// it is reading state about a file that is somewhere else, or
	// nowhere. A work with a book keeps its history with the book, even
	// when the file is missing, so this section is simply not here
	// (ADR-0024).
	if d.BookID == "" {
		<section class="card">
			<h2>Delete</h2>
			<p class="muted">
				This server holds no file for this book — the reading came
				from a device. Deleting it removes these positions, these
				sessions and the statistics above, for this account only.
				A device still syncing this book will bring it back as a new
				entry, starting from wherever that device is now.
			</p>
			<form
				method="post"
				action={ prefix + "works/" + d.Work.ID + "/delete" }
				hx-confirm="Delete this book's reading history? A device still syncing this book will bring it back as a new entry."
			>
				<input type="hidden" name="csrf" value={ csrf }/>
				<button class="danger" type="submit">Delete reading history</button>
			</form>
		</section>
	}
}
