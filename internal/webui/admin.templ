package webui

import (
	"github.com/chmouel/liseur-sync/internal/buildinfo"
"github.com/chmouel/liseur-sync/internal/audiobookshelf"
	"github.com/chmouel/liseur-sync/internal/store"
)

// adminOverview is the page an operator lands on: what this build is,
// how much of everything there is, and how the server was configured.
templ adminOverviewBody(prefix string, counts store.AdminCounts, build buildinfo.Info, cfg configFacts, abs audiobookshelf.Status) {
	<h2>Administration overview</h2>
	<section class="card">
		<h2>This build</h2>
		<dl class="facts">
			<dt>Version</dt>
			<dd>{ build.Short() }</dd>
			if build.ShortRevision() != "" {
				<dt>Revision</dt>
				<dd><code>{ build.ShortRevision() }</code></dd>
			}
			if build.Go != "" {
				<dt>Go</dt>
				<dd>{ build.Go }</dd>
			}
		</dl>
	</section>
	<section class="card">
		<h2>Instance</h2>
		<dl class="facts">
			<dt>Accounts</dt>
			<dd>
				{ i2s(counts.Users) }
				<span class="muted">
					{ "(" + i2s(counts.AdminUsers) + " admin, " +
						i2s(counts.DisabledUsers) + " disabled)" }
				</span>
			</dd>
			<dt>Folders</dt>
			<dd>
				{ i2s(counts.Folders) }
				<span class="muted">
					{ "(" + i2s(counts.FoldersByKind["plain"]) + " plain, " +
						i2s(counts.FoldersByKind["calibre"]) + " Calibre)" }
				</span>
			</dd>
			<dt>Books</dt>
			<dd>
				{ i2s(counts.BooksByStatus["active"]) } active
				<span class="muted">
					{ "(" + i2s(counts.BooksByStatus["missing"]) + " missing)" }
				</span>
			</dd>
		</dl>
		<p class="muted">
			<a href={ settingsAdminHref(prefix, "maintenance") }>Maintenance</a> breaks the
			same figures down by folder kind and book status. A run of missing
			books usually means a disk is not where it was.
		</p>
	</section>
 <section class="card">
  <h2>Audiobookshelf</h2>
  <dl class="facts">
   <dt>Status</dt><dd>
 if abs.Enabled {
 Enabled
 } else {
 Disabled
 }
 </dd>
   <dt>Server version</dt><dd>
 if abs.Version != "" {
 { abs.Version }
 } else {
 Unknown
 }
 </dd>
   <dt>Last successful pass</dt><dd>
 if abs.LastSuccess != nil {
 { abs.LastSuccess.Format("2006-01-02 15:04 UTC") }
 } else {
 Never
 }
 </dd>
   <dt>Errors</dt><dd>{ i2s(abs.Errors) }</dd>
  </dl>
 </section>
	<section class="card">
		<h2>Configuration</h2>
		<p class="muted">
			Read from the configuration file at startup. There is no reload:
			changing any of these means restarting the server. The database
			connection string is deliberately not shown — it carries a
			password.
		</p>
		<dl class="facts">
			for _, f := range cfg.Fields {
				<dt>{ f.Label }</dt>
				<dd>{ f.Value }</dd>
			}
		</dl>
	</section>
}
