package webui

import "github.com/chmouel/liseur-sync/internal/metadata"

// The libraries page. It shows what a library *is* — kind, owner, root,
// who was granted access, how its filenames are read — and never what
// it holds (ADR-0013).

templ adminLibrariesBody(prefix string, csrf string, libs []adminLibraryView, next string, flash Flash) {
	<h1>Libraries</h1>
	@adminFlash(flash)
	<section class="card">
		<h2>Create a library</h2>
		<p class="muted">
			A managed library holds what people upload to it and names no path
			on this server. A <i>directory</i> or <i>Calibre</i> library
			indexes a tree that already exists here, so it is created with
			<code>liseur-sync admin add-library</code> — naming a server
			path is not something a browser session should be able to do.
		</p>
		<form method="post" action={ prefix + "admin/libraries" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<label>Owner <input name="owner" required autocomplete="off" placeholder="account name"/></label>
			<label>Name <input name="name" required autocomplete="off"/></label>
			<button type="submit" class="primary">Create managed library</button>
		</form>
	</section>
	if len(libs) == 0 {
		<section class="card"><p class="muted">No libraries yet.</p></section>
	}
	for _, lib := range libs {
		@adminLibraryCard(prefix, csrf, lib)
	}
	if next != "" {
		<p><a href={ prefix + "admin/libraries?after=" + next }>Next page →</a></p>
	}
}

templ adminLibraryCard(prefix string, csrf string, v adminLibraryView) {
	<section class="card">
		<h2>{ v.Library.Name }</h2>
		<p class="muted">
			<code>{ v.Library.ID }</code>
			· { libraryAxes(v.Library) }
			· owned by
			if v.OwnerName != "" {
				{ v.OwnerName }
			} else {
				<span class="tag">unknown</span>
			}
			· created { v.Library.CreatedAt.Format("2006-01-02") }
		</p>
		if v.Refreshable() {
			<p class="muted">Root: <code>{ v.Root() }</code></p>
			<p class="muted">{ v.RefreshState() }</p>
			if v.RefreshFailure() != "" {
				<p class="error">Last refresh failed: { v.RefreshFailure() }</p>
			}
			<form method="post" action={ prefix + "admin/libraries/" + v.Library.ID + "/refresh" } class="inline">
				<input type="hidden" name="csrf" value={ csrf }/>
				<button type="submit">Refresh now</button>
			</form>
		}
		<h3>Access</h3>
		if len(v.Grants) == 0 {
			<p class="muted">Only the owner.</p>
		} else {
			<table>
				<tr><th>Account</th><th>Role</th><th>Since</th></tr>
				for _, g := range v.Grants {
					<tr>
						<td>{ g.UserName }</td>
						<td>{ string(g.Role) }</td>
						<td>{ g.CreatedAt.Format("2006-01-02") }</td>
					</tr>
				}
			</table>
			if v.MoreGrants {
				<p class="muted">Showing the most recent grants only.</p>
			}
		}
		<form method="post" action={ prefix + "admin/libraries/" + v.Library.ID + "/access" } class="inline">
			<input type="hidden" name="csrf" value={ csrf }/>
			<label>Account <input name="user" required autocomplete="off"/></label>
			<label>
				Role
				<select name="role">
					<option value="read">read</option>
					<option value="manage">manage</option>
					<option value="none">no access</option>
				</select>
			</label>
			<button type="submit" class="primary">Apply</button>
		</form>
		<h3>Filename layout</h3>
		if v.LayoutError != "" {
			<p class="error">This library's configuration cannot be read: { v.LayoutError }</p>
		}
		<p class="muted">
			How files uploaded here are read for author, series and title.
			if v.Configured {
				Currently { metadata.FormatPathPatterns(v.Layouts) }.
			} else {
				Currently the default, { metadata.FormatPathPatterns(v.Layouts) }.
			}
			Choosing none restores the default.
		</p>
		<form method="post" action={ prefix + "admin/libraries/" + v.Library.ID + "/layout" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			for _, p := range metadata.AllPathPatterns() {
				<label class="check">
					if hasLayout(v.Layouts, p) && v.Configured {
						<input type="checkbox" name="layout" value={ string(p) } checked/>
					} else {
						<input type="checkbox" name="layout" value={ string(p) }/>
					}
					<code>{ string(p) }</code>
				</label>
			}
			<button type="submit" class="primary">Save layout</button>
		</form>
	</section>
}

templ adminUserLibrariesSection(prefix string, libs []adminUserLibrary, more bool) {
	<section class="card">
		<h2>Libraries</h2>
		if len(libs) == 0 {
			<p class="muted">This account owns no libraries and was granted none.</p>
		} else {
			<table>
				<tr><th>Library</th><th>Source</th><th>Access</th></tr>
				for _, l := range libs {
					<tr>
						<td>{ l.Library.Name }</td>
						<td>{ libraryAxes(l.Library) }</td>
						<td>
							if l.Owner {
								owner
							} else {
								{ string(l.Role) }
							}
						</td>
					</tr>
				}
			</table>
			if more {
				<p class="muted">
					More than this page shows; the full list is on
					<a href={ prefix + "admin/libraries" }>Libraries</a>.
				</p>
			}
		}
	</section>
}
