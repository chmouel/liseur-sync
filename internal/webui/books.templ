package webui

// Books: the browser side of the content server — pick a library,
// upload an EPUB, see what came of it, download it back.

type LibraryOption struct {
	ID       string
	Name     string
	CanWrite bool
	Selected bool
}

type BookRow struct {
	ID       string
	Title    string
	Author   string
	Added    string
	CanGet   bool
	FileSize string
}

// UploadRow is one upload that has not become a book: still working, or
// stopped for a reason the person who uploaded it deserves to see.
type UploadRow struct {
	When     string
	State    string
	Pending  bool
	Reason   string
}

// TrashRow is one deleted book that can still be brought back.
type TrashRow struct {
	ID    string
	Title string
	Until string
}

type BooksView struct {
	Libraries []LibraryOption
	Selected  string
	CanWrite  bool
	Books     []BookRow
	Uploads   []UploadRow
	Trash     []TrashRow
	NextURL   string
	Notice    string
	Problem   string
}

templ booksPage(prefix string, u userCtx, csrf string, v BooksView) {
	@layout("Books", prefix, u.User, csrf, booksBody(prefix, csrf, v))
}

templ booksBody(prefix, csrf string, v BooksView) {
	<h1>Books</h1>
	if v.Problem != "" {
		<p class="error" role="alert">{ v.Problem }</p>
	}
	if v.Notice != "" {
		<p class="notice" role="status">{ v.Notice }</p>
	}
	if len(v.Libraries) == 0 {
		<section class="card">
			<p class="muted">
				You have no libraries yet. An administrator creates one with
				<code>liseur-sync admin create-library</code> and grants you access.
			</p>
		</section>
	} else {
		<section class="card">
			<h2>Library</h2>
			<form method="get" action={ prefix + "books" }>
				<select name="library" onchange="this.form.submit()">
					for _, l := range v.Libraries {
						if l.Selected {
							<option value={ l.ID } selected>{ l.Name }</option>
						} else {
							<option value={ l.ID }>{ l.Name }</option>
						}
					}
				</select>
				<noscript><button type="submit">Show</button></noscript>
			</form>
		</section>
		if v.CanWrite {
			<section class="card">
				<h2>Upload an EPUB</h2>
				<p class="muted">
					The file is stored straight away; the book appears once a
					background pass has read its metadata, usually within a
					minute. Reload to see it — an upload that cannot be read
					is listed below with the reason.
				</p>
				<form method="post" action={ prefix + "books/upload" } enctype="multipart/form-data">
					<input type="hidden" name="csrf" value={ csrf }/>
					<input type="hidden" name="library" value={ v.Selected }/>
					<input type="file" name="file" accept=".epub,application/epub+zip" required/>
					<button type="submit">Upload</button>
				</form>
			</section>
		}
		if len(v.Uploads) > 0 {
			<section class="card">
				<h2>Uploads in progress</h2>
				<table>
					<tr><th>Uploaded</th><th>Status</th></tr>
					for _, up := range v.Uploads {
						<tr>
							<td>{ up.When }</td>
							if up.Pending {
								<td class="muted">{ up.State }</td>
							} else {
								<td class="error">{ up.Reason }</td>
							}
						</tr>
					}
				</table>
			</section>
		}
		if len(v.Trash) > 0 {
			<section class="card">
				<h2>Recently deleted</h2>
				<p class="muted">
					These are kept for a while before their files are removed for
					good. Until then they can be put back.
				</p>
				<table>
					<tr><th>Title</th><th>Kept until</th><th></th></tr>
					for _, b := range v.Trash {
						<tr>
							<td>{ orPlaceholder(b.Title) }</td>
							<td>{ orPlaceholder(b.Until) }</td>
							<td>
								<form method="post" action={ prefix + "books/" + b.ID + "/restore" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<input type="hidden" name="library" value={ v.Selected }/>
									<button type="submit">Put back</button>
								</form>
							</td>
						</tr>
					}
				</table>
			</section>
		}
		<section class="card">
			<h2>In this library</h2>
			if len(v.Books) == 0 {
				<p class="muted">No books yet.</p>
			} else {
				<table>
					<tr><th>Title</th><th>Added</th><th></th><th></th></tr>
					for _, b := range v.Books {
						<tr>
							<td><a href={ prefix + "books/" + b.ID }>{ orPlaceholder(b.Title) }</a></td>
							<td>{ b.Added }</td>
							<td>
								if b.CanGet {
									<a href={ prefix + "books/" + b.ID + "/download" }>Download</a>
								} else {
									<span class="muted">no file</span>
								}
							</td>
							<td>
								if v.CanWrite {
									<form method="post" action={ prefix + "books/" + b.ID + "/delete" }>
										<input type="hidden" name="csrf" value={ csrf }/>
										<input type="hidden" name="library" value={ v.Selected }/>
										<button type="submit">Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</table>
				if v.NextURL != "" {
					<p><a href={ v.NextURL }>Next page</a></p>
				}
			}
		</section>
	}
}

type BookFileRow struct {
	Name      string
	MediaType string
	SHA256    string
}

type BookView struct {
	ID          string
	Title       string
	Subtitle    string
	Description string
	Publisher   string
	Published   string
	Added       string
	LibraryID   string
	Files       []BookFileRow
}

templ bookPage(prefix string, u userCtx, csrf string, b BookView) {
	@layout(orPlaceholder(b.Title), prefix, u.User, csrf, bookBody(prefix, b))
}

templ bookBody(prefix string, b BookView) {
	<h1>{ orPlaceholder(b.Title) }</h1>
	if b.Subtitle != "" {
		<p class="muted">{ b.Subtitle }</p>
	}
	<section class="card">
		<table>
			if b.Publisher != "" {
				<tr><th>Publisher</th><td>{ b.Publisher }</td></tr>
			}
			if b.Published != "" {
				<tr><th>Published</th><td>{ b.Published }</td></tr>
			}
			<tr><th>Added</th><td>{ b.Added }</td></tr>
		</table>
		if b.Description != "" {
			<p>{ b.Description }</p>
		}
	</section>
	<section class="card">
		<h2>Files</h2>
		if len(b.Files) == 0 {
			<p class="muted">
				This book is catalogued but its content is no longer stored.
			</p>
		} else {
			<table>
				<tr><th>Name</th><th>Type</th><th></th></tr>
				for _, f := range b.Files {
					<tr>
						<td>{ f.Name }</td>
						<td>{ f.MediaType }</td>
						<td><a href={ prefix + "books/" + b.ID + "/download" }>Download</a></td>
					</tr>
				}
			</table>
		}
	</section>
	<p><a href={ prefix + "books?library=" + b.LibraryID }>Back to the library</a></p>
}
