package webui

import "strconv"

// Books: the browser side of the catalog — pick a folder, look at what
// is in it, read it or take a copy.

// FolderOption is one watched folder as the picker shows it. It carries
// a name and an id and nothing else: a folder's root path is a
// filesystem oracle and appears only on the admin page (ADR-0017).
type FolderOption struct {
	ID       string
	Name     string
	Selected bool
}

type BookRow struct {
	ID     string
	Title  string
	Author string
	Added  string
	CanGet bool
	// CanRead is set when there is an EPUB to open in the browser
	// reader. A book stored as something else is still downloadable.
	CanRead bool
}

// ChipLink is one entity a book claims, with the page listing everything
// else that claims it.
type ChipLink struct {
	Name string
	URL  string
}

type BookView struct {
	ID          string
	Title       string
	Subtitle    string
	Description string
	Publisher   string
	Published   string
	Added       string
	FolderID    string
	// The file, which is one file: a book is a row over a publication
	// somebody's folder holds, so there is no list here any more.
	Filename  string
	MediaType string
	SHA256    string
	Offline   bool
	// Present is false for a book the last completed pass could not
	// find. The row stays — it is the record of what the folder held,
	// and of anybody's reading position against it — but there is
	// nothing to download until the file comes back.
	Present bool
	CanRead bool
	Finished bool
	// Progression is the reader's newest known position for this book.
	// Nil means the reader has not opened it on any synced device.
	Progression *float64
	// Retirable is a missing book an administrator may take out of the
	// catalog: admin, file already reported missing, and not in a
	// Calibre folder, where metadata.db is authoritative and the next
	// pass would put the book back (ADR-0022, ADR-0024).
	Retirable bool
	// Deletable is a book an administrator may delete outright: file,
	// row and all. Only where a book could have been uploaded in the
	// first place, because that flag is what marks the one place this
	// server may write under a folder root (ADR-0023, ADR-0025).
	Deletable bool
	Notice    string
	Problem   string
	// SeriesAssign is the assign dialog rendered into the page rather
	// than fetched. It is nil in the ordinary case: with scripting on,
	// htmx swaps the dialog in where the section sits. It is set when
	// the fragment route is reached without htmx, which is what that
	// section's plain link does.
	SeriesAssign *SeriesAssignView
	// Chips are the book's entities as links: the fastest way from one
	// book to the rest of its author or its series.
	Authors []ChipLink
	Series  []ChipLink
	// SeriesNow is what the organization card states before anybody
	// opens the editor, with this book's number in each series.
	SeriesNow []BookSeriesLine
	// SeriesSource names the layer SeriesNow came from (ADR-0018).
	SeriesSource string
	// SeriesFolderNote is what the folder says, and is set only when a
	// claim is in force over it: a reader who arranged their own shelf
	// should be able to see what they arranged it away from.
	SeriesFolderNote string
	// Byline is the authors as one line, for the hero and the title tag.
	Byline string
	// Audio is the audiobook paired with this book, nil when there is
	// none the reader can see.
	Audio *BookAudioView
	// CanAddAudio offers the audiobook upload: the book's folder accepts
	// uploads and no audiobook is linked to it yet (ADR-0058).
	CanAddAudio bool
}

// BookSeriesLine is one series the organization card names: the shelf it
// links to and where this book sits on it.
type BookSeriesLine struct {
	Name     string
	Position string
	URL      string
}

templ bookPage(prefix string, u userCtx, csrf string, b BookView) {
	@layout(orPlaceholder(b.Title), prefix, u, csrf, bookBody(prefix, csrf, b))
}

templ bookBody(prefix, csrf string, b BookView) {
	if b.Problem != "" {
		<p class="error" role="alert">{ b.Problem }</p>
	}
	if b.Notice != "" {
		<p class="notice" role="status">{ b.Notice }</p>
	}
	<section class="hero">
		<div class="art">
			<img
				src={ prefix + "books/" + b.ID + "/cover?size=full" }
				alt=""
				width="333"
				height="500"
			/>
		</div>
		<div class="facts">
			<h1>{ orPlaceholder(b.Title) }</h1>
			if b.Subtitle != "" {
				<p class="byline">{ b.Subtitle }</p>
			}
			if b.Byline != "" {
				<p class="byline">{ b.Byline }</p>
			}
			<div class="reading-state">
				if b.Finished {
					<span class="tag done">Finished</span>
				} else if b.Progression != nil && *b.Progression > 0 {
					<span class="tag">Reading { pct(*b.Progression) }</span>
					@progressBar("bar", *b.Progression)
				} else {
					<span class="tag">Unread</span>
				}
			</div>
			<div class="cta">
				if b.CanRead {
					<a class="btn primary" href={ prefix + "books/" + b.ID + "/read" }>Read</a>
				}
				if b.Audio != nil && b.Audio.Playable {
					<a class="btn listen-btn" href="#listen">
						<span aria-hidden="true">@uiIcon("Audiobookshelf")</span>
						Listen
					</a>
				}
				@markBookButton(prefix, csrf, b.ID, b.Finished)
				if b.Present {
					<a class="btn" href={ prefix + "books/" + b.ID + "/download" }>Download</a>
					if b.Offline {
						<button
							class="btn"
							type="button"
							data-offline-book={ b.ID }
							data-offline-digest={ b.SHA256 }
						>Save offline</button>
						<span class="muted" data-offline-status={ b.ID } role="status"></span>
					}
				}
			</div>
			if len(b.Series) > 0 || len(b.Authors) > 0 {
				<div class="bookrelations">
					if len(b.Series) > 0 {
						<div>
							<span class="eyebrow">Series</span>
							<div class="chips">
					for _, c := range b.Series {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
							</div>
						</div>
					}
					if len(b.Authors) > 0 {
						<div>
							<span class="eyebrow">Contributors</span>
							<div class="chips">
					for _, c := range b.Authors {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
							</div>
						</div>
					}
				</div>
			}
			<dl class="kv">
				if b.Publisher != "" {
					<dt>Publisher</dt>
					<dd>{ b.Publisher }</dd>
				}
				if b.Published != "" {
					<dt>Published</dt>
					<dd>{ b.Published }</dd>
				}
				<dt>Added</dt>
				<dd>{ b.Added }</dd>
			</dl>
		</div>
	</section>
	if b.Audio != nil || b.CanAddAudio {
		@bookListen(prefix, csrf, b)
	}
	if b.Description != "" {
		<section class="card">
			<h2>About</h2>
			<div class="description">
				@descriptionHTML(b.Description)
			</div>
		</section>
	}
	<details class="card bookorganization">
		<summary>Library organization</summary>
		// The editor is fetched rather than rendered: it is a store read
		// a reader who is not editing does not need, and htmx swaps it in
		// where this section sits. What the section says without it comes
		// from the page's own read, so the current series is legible
		// before anybody decides to change it. With scripting off the
		// link is a plain link that comes back here with the editor
		// already open.
		if b.SeriesAssign != nil {
			@seriesAssignForm(prefix, csrf, *b.SeriesAssign)
		} else {
			<div id="series-assign" class="book-organization-section">
				<h2>Series</h2>
				if len(b.SeriesNow) > 0 {
					<p class="seriesnow">
						for _, s := range b.SeriesNow {
							<a class="chip" href={ prefix + s.URL }>
								{ s.Name }
								if s.Position != "" {
									<span class="num">{ " #" + s.Position }</span>
								}
							</a>
						}
					</p>
				} else if b.SeriesSource != "" {
					// Only a read that succeeded can say a book is in no
					// series. SeriesSource is set on every success, so an
					// unset one means the layers did not come back, and
					// the section says nothing rather than something
					// false about somebody's shelf.
					<p>This book is in no series.</p>
				}
				if b.SeriesSource != "" {
					<p class="muted">{ seriesSourceSentence(b.SeriesSource) }</p>
				}
				if b.SeriesFolderNote != "" {
					<p class="muted">{ b.SeriesFolderNote }</p>
				}
				<p>
					<a
						class="btn"
						href={ prefix + "books/" + b.ID + "/series" }
						hx-get={ prefix + "books/" + b.ID + "/series" }
						hx-target="#series-assign"
						hx-swap="outerHTML"
					>Change this book's series</a>
				</p>
			</div>
		}
		<div class="book-organization-section">
			<h2>File</h2>
		if !b.Present {
			<p class="muted">
				The last look through this folder could not find this book's
				file. Nothing has been deleted — it comes back on its own if
				the file does.
			</p>
			if b.Retirable {
				<form
					method="post"
					action={ prefix + "books/" + b.ID + "/delete" }
					hx-confirm="Remove this book from the catalog? Readers keep what they read, and the file on disk is untouched."
				>
					<input type="hidden" name="csrf" value={ csrf }/>
					<button class="danger" type="submit">Remove from the catalog</button>
					<span class="muted">
						For a file that is not coming back. Anyone who read it keeps
						their reading, as an entry only they can remove.
					</span>
				</form>
			}
		} else {
			<table>
				<thead>
					<tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col"></th></tr>
				</thead>
				<tr>
					<td>{ orPlaceholder(b.Filename) }</td>
					<td>{ b.MediaType }</td>
					<td><a href={ prefix + "books/" + b.ID + "/download" }>Download</a></td>
				</tr>
			</table>
			if b.Deletable {
				<form
					method="post"
					action={ prefix + "books/" + b.ID + "/destroy" }
					hx-confirm="Delete this book from the server? The file itself is deleted, for every device. This cannot be undone."
				>
					<input type="hidden" name="csrf" value={ csrf }/>
					<button class="danger" type="submit">Delete this book</button>
					<label class="muted">
						<input type="checkbox" name="forget_reading" value="true"/>
						Also delete my reading history for it
					</label>
					<span class="muted">
						The file is deleted from this server's disk. There is no
						trash to take it back out of. Everybody's reading survives
						unless they remove it themselves; the box above removes
						yours.
					</span>
				</form>
			}
		}
		</div>
	</details>
	<p><a href={ prefix + "library?folder=" + b.FolderID }>Back to the library</a></p>
}

// bookListen is the audiobook card: a player when the audiobook lines
// up with the text, a sentence when it does not, and the upload form
// when there is none yet. The player is the browser's own <audio>;
// book-audio.js resumes it from the reading position and files where
// the listener got to.
templ bookListen(prefix, csrf string, b BookView) {
	<section
		id="listen"
		class="card book-listen"
		tabindex="-1"
		aria-labelledby="listen-title"
		if b.Audio != nil && b.Audio.Playable {
			data-book-audio={ b.ID }
			data-api-base={ prefix + "../" }
			data-token-url={ prefix + "reader/token" }
			data-csrf={ csrf }
			data-edition={ b.SHA256 }
			data-duration={ strconv.FormatFloat(b.Audio.Seconds, 'f', -1, 64) }
			data-title={ orPlaceholder(b.Title) }
			data-artist={ b.Byline }
			data-cover={ prefix + "books/" + b.ID + "/cover?size=full" }
		}
	>
		<h2 id="listen-title">
			<span class="listen-glyph" aria-hidden="true">@uiIcon("Audiobookshelf")</span>
			Audiobook
		</h2>
		if b.Audio != nil {
			<p class="muted listen-meta">
				if b.Audio.Narrators != "" {
					{ "Narrated by " + b.Audio.Narrators }
					if b.Audio.Duration != "" {
						{ " · " }
					}
				}
				{ b.Audio.Duration }
				if len(b.Audio.Chapters) > 0 {
					{ " · " + plural(len(b.Audio.Chapters), "chapter") }
				}
			</p>
			if b.Audio.Playable {
				@audioPlayer(audioPlayerView{Inline: true, Src: prefix + "books/" + b.ID + "/audio", Seconds: b.Audio.Seconds, Chapters: b.Audio.Chapters})
				<script type="module" src={ prefix + "static/book-audio.js" }></script>
			} else {
				<p class="muted">
					This audiobook is attached, but its chapters could not be
					lined up with the book's text, so it cannot follow your
					reading position.
				</p>
			}
		} else {
			<p class="muted">
				Add an .m4b audiobook of this book. It is saved with the book in
				its folder, and you can listen from here or from the reader.
			</p>
			<form
				class="upload audiobook-upload"
				method="post"
				enctype="multipart/form-data"
				action={ prefix + "books/" + b.ID + "/audiobook?csrf=" + csrf }
				data-audiobook-upload
			>
				<input type="file" name="file" accept=".m4b,audio/mp4,audio/x-m4b" required/>
				<button class="btn" type="submit">Upload audiobook</button>
				<progress max="100" value="0" hidden data-upload-progress></progress>
				<span class="uploadstatus muted" role="status"></span>
			</form>
			<script type="module" src={ prefix + "static/book-audio.js" }></script>
		}
	</section>
}

templ markBookForm(prefix, csrf, bookID string, finished bool) {
	<form class="reading-status" method="post" action={ prefix + "books/" + bookID + "/reading-status" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		if finished {
			<button class="linkish" type="submit" name="status" value="unread">Mark unread</button>
		} else {
			<button class="linkish" type="submit" name="status" value="read">Mark read</button>
		}
	</form>
}

templ markBookButton(prefix, csrf, bookID string, finished bool) {
	<form class="reading-status" method="post" action={ prefix + "books/" + bookID + "/reading-status" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		if finished {
			<button class="btn" type="submit" name="status" value="unread">Mark unread</button>
		} else {
			<button class="btn" type="submit" name="status" value="read">Mark read</button>
		}
	</form>
}
