package webui

// Books: the browser side of the content server — pick a library,
// upload an EPUB, see what came of it, download it back.

type LibraryOption struct {
	ID       string
	Name     string
	CanWrite bool
	Selected bool
}

type BookRow struct {
	ID       string
	Title    string
	Author   string
	Added    string
	CanGet   bool
	// CanRead is set when there is an EPUB to open in the browser
	// reader. A book stored as something else is still downloadable.
	CanRead  bool
	FileSize string
}

// UploadRow is one upload that has not become a book: still working, or
// stopped for a reason the person who uploaded it deserves to see.
type UploadRow struct {
	When     string
	State    string
	Pending  bool
	Reason   string
}

// TrashRow is one deleted book that can still be brought back.
type TrashRow struct {
	ID    string
	Title string
	Until string
}

// ReviewRow is one watched book whose source file changed under it. The
// server will not decide what that means — a replaced file may be a
// better scan of the same book or a different book entirely — so it says
// so here and keeps serving the copy it validated.
type ReviewRow struct {
	ID     string
	Title  string
	Reason string
}

// DuplicateGroup is a set of books in one library that are the same
// bytes. The page reports them and leaves the deciding to the user: two
// entries for one file may be exactly what somebody meant.
type DuplicateGroup struct {
	Titles []string
}

// SimilarGroup is the weaker report: books that look like one book
// without being one file. Each entry links, unlike a digest group, because
// deciding this one needs looking at the books rather than trusting the
// server.
type SimilarGroup struct {
	Books []BookRow
}

type BooksView struct {
	Libraries []LibraryOption
	Selected  string
	CanWrite  bool
	Books     []BookRow
	Uploads   []UploadRow
	Trash      []TrashRow
	Review     []ReviewRow
	Duplicates []DuplicateGroup
	Similar    []SimilarGroup
	NextURL    string
	Notice    string
	Problem   string
	// View is the reader's grid/list preference, copied out of the
	// cookie so the body does not need the whole shell context.
	View string
	// Back is where the view toggle returns to: this page, with its
	// library selection intact.
	Back string
}

templ booksPage(prefix string, u userCtx, csrf string, v BooksView) {
	@layout("Books", prefix, u, csrf, booksBody(prefix, csrf, v))
}

templ booksBody(prefix, csrf string, v BooksView) {
	<h1>Books</h1>
	if v.Problem != "" {
		<p class="error" role="alert">{ v.Problem }</p>
	}
	if v.Notice != "" {
		<p class="notice" role="status">{ v.Notice }</p>
	}
	if len(v.Libraries) == 0 {
		<section class="card">
			<p class="muted">
				You have no libraries yet. An administrator creates one with
				<code>liseur-sync admin create-library</code> and grants you access.
			</p>
		</section>
	} else {
		<div class="toolbar">
			<form method="get" action={ prefix + "books" }>
				<label class="visually-hidden" for="library-pick">Library</label>
				<select id="library-pick" name="library" onchange="this.form.submit()">
					for _, l := range v.Libraries {
						if l.Selected {
							<option value={ l.ID } selected>{ l.Name }</option>
						} else {
							<option value={ l.ID }>{ l.Name }</option>
						}
					}
				</select>
				<noscript><button type="submit">Show</button></noscript>
			</form>
			if v.Selected != "" {
				@searchForm(prefix, SearchView{LibraryID: v.Selected})
				<div class="chips">
					<a class="chip" href={ prefix + "libraries/" + v.Selected + "/series" }>Series</a>
					<a class="chip" href={ prefix + "libraries/" + v.Selected + "/contributors" }>Contributors</a>
					<a class="chip" href={ prefix + "libraries/" + v.Selected + "/tags" }>Tags</a>
					<a class="chip" href={ prefix + "libraries/" + v.Selected + "/genres" }>Genres</a>
				</div>
			}
			<span class="spacer"></span>
			@viewToggle(prefix, csrf, v.Back, v.View)
		</div>
		if v.CanWrite {
			<details class="card">
				<summary>Upload an EPUB</summary>
				<p class="muted">
					The file is stored straight away; the book appears once a
					background pass has read its metadata, usually within a
					minute. Reload to see it — an upload that cannot be read
					is listed below with the reason.
				</p>
				<form method="post" action={ prefix + "books/upload" } enctype="multipart/form-data">
					<input type="hidden" name="csrf" value={ csrf }/>
					<input type="hidden" name="library" value={ v.Selected }/>
					<input type="file" name="file" accept=".epub,application/epub+zip" required/>
					<button type="submit">Upload</button>
				</form>
			</details>
		}
		if len(v.Uploads) > 0 {
			<section class="card">
				<h2>Uploads in progress</h2>
				<table>
					<tr><th>Uploaded</th><th>Status</th></tr>
					for _, up := range v.Uploads {
						<tr>
							<td>{ up.When }</td>
							if up.Pending {
								<td class="muted">{ up.State }</td>
							} else {
								<td class="error">{ up.Reason }</td>
							}
						</tr>
					}
				</table>
			</section>
		}
		if len(v.Trash) > 0 {
			<section class="card">
				<h2>Recently deleted</h2>
				<p class="muted">
					These are kept for a while before their files are removed for
					good. Until then they can be put back.
				</p>
				<table>
					<tr><th>Title</th><th>Kept until</th><th></th></tr>
					for _, b := range v.Trash {
						<tr>
							<td>{ orPlaceholder(b.Title) }</td>
							<td>{ orPlaceholder(b.Until) }</td>
							<td>
								<form method="post" action={ prefix + "books/" + b.ID + "/restore" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<input type="hidden" name="library" value={ v.Selected }/>
									<button type="submit">Put back</button>
								</form>
							</td>
						</tr>
					}
				</table>
			</section>
		}
		if len(v.Review) > 0 {
			<section class="card">
				<h2>Changed under us</h2>
				<p class="muted">
					The file behind each of these was replaced with something
					different. The copy already stored is still what downloads,
					because a new file at the same path is not proof that it is
					the same book. Accept it to put the book back in the catalog,
					or delete the book if the file is now something else.
				</p>
				<table>
					<tr><th>Title</th><th>Why</th><th></th></tr>
					for _, b := range v.Review {
						<tr>
							<td>{ orPlaceholder(b.Title) }</td>
							<td class="muted">{ b.Reason }</td>
							<td>
								<form method="post" action={ prefix + "books/" + b.ID + "/accept" }>
									<input type="hidden" name="csrf" value={ csrf }/>
									<input type="hidden" name="library" value={ v.Selected }/>
									<button type="submit">Accept this copy</button>
								</form>
							</td>
						</tr>
					}
				</table>
			</section>
		}
		if len(v.Duplicates) > 0 {
			<section class="card">
				<h2>The same file, more than once</h2>
				<p class="muted">
					These entries hold identical bytes. The file itself is only
					stored once, so this costs no space — but if you did not mean
					to add it twice, deleting the spare tidies the list.
				</p>
				for _, group := range v.Duplicates {
					<ul>
						for _, title := range group.Titles {
							<li>{ orPlaceholder(title) }</li>
						}
					</ul>
				}
			</section>
		}
		if len(v.Similar) > 0 {
			<section class="card">
				<h2>Possibly the same book</h2>
				<p class="muted">
					These have the same title and an author in common, but they
					are different files — two builds of one book, most likely.
					This is a guess, so nothing has been changed: open them and
					decide.
				</p>
				for _, group := range v.Similar {
					<ul>
						for _, b := range group.Books {
							<li>
								<a href={ prefix + "books/" + b.ID }>
									{ orPlaceholder(b.Title) }
								</a>
								{ " · added " }
								{ b.Added }
							</li>
						}
					</ul>
				}
			</section>
		}
		<section class="card">
			<h2>In this library</h2>
			if len(v.Books) == 0 {
				<p class="muted">No books yet.</p>
			} else if v.View == viewList {
				<table>
					<tr><th></th><th>Title</th><th>Added</th><th></th><th></th></tr>
					for _, b := range v.Books {
						<tr>
							<td>
								<a href={ prefix + "books/" + b.ID }>
									<img
										class="cover-thumb"
										src={ prefix + "books/" + b.ID + "/cover?size=thumbnail" }
										alt=""
										loading="lazy"
										width="40"
										height="60"/>
								</a>
							</td>
							<td><a href={ prefix + "books/" + b.ID }>{ orPlaceholder(b.Title) }</a></td>
							<td>{ b.Added }</td>
							<td>
								if b.CanRead {
									<a href={ prefix + "books/" + b.ID + "/read" }>Read</a>
								}
								if b.CanGet {
									<a href={ prefix + "books/" + b.ID + "/download" }>Download</a>
								} else if !b.CanRead {
									<span class="muted">no file</span>
								}
							</td>
							<td>
								if v.CanWrite {
									<form method="post" action={ prefix + "books/" + b.ID + "/delete" }>
										<input type="hidden" name="csrf" value={ csrf }/>
										<input type="hidden" name="library" value={ v.Selected }/>
										<button type="submit">Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</table>
				if v.NextURL != "" {
					<p><a href={ v.NextURL }>Next page</a></p>
				}
			} else {
				@bookGrid(prefix, csrf, v)
			}
		</section>
	}
}

// bookGrid is its own component so the first page and every htmx
// continuation render from the same markup.
templ bookGrid(prefix, csrf string, v BooksView) {
	<div class="grid">
		@booksFragment(prefix, csrf, v)
	</div>
}

// booksFragment is a page of cards plus the sentinel that fetches the
// next one. It replaces itself, so the cards it brings land inside the
// grid rather than after it.
//
// The sentinel is a link first and a trigger second: with scripting off
// it is the "next page" the table view has always had.
templ booksFragment(prefix, csrf string, v BooksView) {
	for _, b := range v.Books {
		@bookCard(prefix, csrf, v.Selected, v.CanWrite, b)
	}
	if v.NextURL != "" {
		<div
			class="more"
			hx-get={ v.NextURL }
			hx-trigger="revealed"
			hx-swap="outerHTML"
		>
			<a href={ v.NextURL }>Next page</a>
		</div>
	}
}

// ChipLink is one entity a book claims, with the page listing everything
// else that claims it.
type ChipLink struct {
	Name string
	URL  string
}

type BookFileRow struct {
	Name      string
	MediaType string
	SHA256    string
}

type BookView struct {
	ID          string
	Title       string
	Subtitle    string
	Description string
	Publisher   string
	Published   string
	Added       string
	LibraryID   string
	Files       []BookFileRow
	CanRead     bool
	Notice      string
	Problem     string
	// Chips are the book's entities as links: the fastest way from one
	// book to the rest of its author, its series or its subject.
	Authors []ChipLink
	Series  []ChipLink
	Tags    []ChipLink
	Genres  []ChipLink
	// Byline is the authors as one line, for the hero and the title tag.
	Byline string
	// CanWrite gates the edit form. A reader sees the book exactly as
	// before; nothing about how it was catalogued is theirs to change.
	CanWrite bool
	Edit     MetadataEditView
	Lookup   LookupView
}

// MetadataFieldView is one editable field: its current text, where that
// text came from, and whether a person has pinned it. The source is
// shown because it is the answer to the question a librarian actually
// has — "why does it say that?" — and the lock is shown because it is
// the answer to "why does it keep saying that?".
type MetadataFieldView struct {
	Value  string
	Source string
	Locked bool
}

type MetadataEditView struct {
	Title        MetadataFieldView
	Subtitle     MetadataFieldView
	Description  MetadataFieldView
	Publisher    MetadataFieldView
	Published    MetadataFieldView
	Tags         MetadataFieldView
	Genres       MetadataFieldView
	Languages    MetadataFieldView
	Series       MetadataFieldView
	Contributors MetadataFieldView
}

templ bookPage(prefix string, u userCtx, csrf string, b BookView) {
	@layout(orPlaceholder(b.Title), prefix, u, csrf, bookBody(prefix, csrf, b))
}

// metadataRow renders one field of the edit form. The hidden `_was`
// input carries what was rendered, so the handler can tell an edit from
// an untouched field; without it, opening a book and pressing Save would
// lock every field on it.
templ metadataRow(name, label, hint string, f MetadataFieldView, area bool) {
	<p>
		<label for={ "md-" + name }>{ label }</label>
		if area {
			<textarea id={ "md-" + name } name={ name } rows="3">{ f.Value }</textarea>
		} else {
			<input id={ "md-" + name } name={ name } value={ f.Value } type="text"/>
		}
		<input type="hidden" name={ name + "_was" } value={ f.Value }/>
		if hint != "" {
			<span class="muted">{ hint }</span>
		}
		if f.Locked {
			<label>
				<input type="checkbox" name={ name + "_unlock" } value="1"/>
				Edited by hand — untick to let the file decide again
			</label>
		} else if f.Source != "" {
			<span class="muted">{ f.Source }</span>
		}
	</p>
}

templ bookEditForm(prefix, csrf string, b BookView) {
	<details class="card">
		<summary>Correct this book</summary>
		<p class="muted">
			Anything you change here is kept as yours: re-reading the file
			will not undo it. Fields you do not touch stay as they are.
		</p>
		<form method="post" action={ prefix + "books/" + b.ID + "/metadata" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			@metadataRow("title", "Title", "", b.Edit.Title, false)
			@metadataRow("subtitle", "Subtitle", "", b.Edit.Subtitle, false)
			@metadataRow("publisher", "Publisher", "", b.Edit.Publisher, false)
			@metadataRow("published", "Published", "", b.Edit.Published, false)
			@metadataRow("description", "Description", "", b.Edit.Description, true)
			@metadataRow("contributors", "Contributors",
				"One per line, with an optional role in brackets: Frank Herbert (author)",
				b.Edit.Contributors, true)
			@metadataRow("series", "Series",
				"One per line, with an optional place in it: Discworld #3",
				b.Edit.Series, true)
			@metadataRow("tags", "Tags", "Separated by commas", b.Edit.Tags, false)
			@metadataRow("genres", "Genres", "Separated by commas", b.Edit.Genres, false)
			@metadataRow("languages", "Languages", "Separated by commas", b.Edit.Languages, false)
			<button class="primary" type="submit">Save</button>
		</form>
	</details>
}

// bookLookupPanel offers to ask elsewhere, and shows what came back.
// Each suggestion is a form of its own carrying the answer it displays,
// so accepting one applies what was read rather than whatever a second
// lookup would return.
templ bookLookupPanel(prefix, csrf string, b BookView) {
	<details class="card">
		<summary>Ask elsewhere</summary>
		<p class="muted">
			This sends the book's title and ISBN to the metadata services
			this server is set up to use. Nothing is changed until you
			accept an answer, and nothing you have edited by hand is
			overwritten when you do.
		</p>
		if b.Lookup.Problem != "" {
			<p class="error" role="alert">{ b.Lookup.Problem }</p>
		}
		<form method="post" action={ prefix + "books/" + b.ID + "/metadata/lookup" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<button type="submit">Look this book up</button>
		</form>
		if b.Lookup.Ran {
			for _, c := range b.Lookup.Candidates {
				@lookupCandidate(prefix, csrf, b, c)
			}
		}
	</details>
}

templ lookupCandidate(prefix, csrf string, b BookView, c CandidateView) {
	<article class="card">
		<h3>{ orPlaceholder(c.Title) }</h3>
		if c.Subtitle != "" {
			<p class="muted">{ c.Subtitle }</p>
		}
		<p class="muted">
			{ c.Provider }
			if c.ByIdentifier {
				— matched on this book's ISBN
			} else {
				— matched on a similar title, so check it
			}
			if c.URL != "" {
				<a href={ templ.SafeURL(c.URL) } rel="noreferrer noopener" target="_blank">see the record</a>
			}
		</p>
		<table>
			if c.Authors != "" {
				<tr><th>Contributors</th><td>{ c.Authors }</td></tr>
			}
			if c.Publisher != "" {
				<tr><th>Publisher</th><td>{ c.Publisher }</td></tr>
			}
			if c.Published != "" {
				<tr><th>Published</th><td>{ c.Published }</td></tr>
			}
			if c.Languages != "" {
				<tr><th>Languages</th><td>{ c.Languages }</td></tr>
			}
			if c.Tags != "" {
				<tr><th>Tags</th><td>{ c.Tags }</td></tr>
			}
		</table>
		if c.Description != "" {
			<p>{ c.Description }</p>
		}
		<form method="post" action={ prefix + "books/" + b.ID + "/metadata/apply" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<input type="hidden" name="candidate" value={ c.Payload }/>
			<input type="hidden" name="revision" value={ b.Lookup.Revision }/>
			<button type="submit">Use this</button>
		</form>
	</article>
}

templ bookBody(prefix, csrf string, b BookView) {
	if b.Problem != "" {
		<p class="error" role="alert">{ b.Problem }</p>
	}
	if b.Notice != "" {
		<p class="notice" role="status">{ b.Notice }</p>
	}
	<section class="hero">
		<div class="art">
			<img
				src={ prefix + "books/" + b.ID + "/cover?size=full" }
				alt=""
				width="333"
				height="500"
			/>
		</div>
		<div class="facts">
			<h1>{ orPlaceholder(b.Title) }</h1>
			if b.Subtitle != "" {
				<p class="byline">{ b.Subtitle }</p>
			}
			if b.Byline != "" {
				<p class="byline">{ b.Byline }</p>
			}
			<div class="cta">
				if b.CanRead {
					<a class="btn primary" href={ prefix + "books/" + b.ID + "/read" }>Read</a>
				}
				if len(b.Files) > 0 {
					<a class="btn" href={ prefix + "books/" + b.ID + "/download" }>Download</a>
				}
			</div>
			if len(b.Series) > 0 || len(b.Authors) > 0 || len(b.Tags) > 0 || len(b.Genres) > 0 {
				<div class="chips">
					for _, c := range b.Series {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
					for _, c := range b.Authors {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
					for _, c := range b.Genres {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
					for _, c := range b.Tags {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
				</div>
			}
			<dl class="kv">
				if b.Publisher != "" {
					<dt>Publisher</dt>
					<dd>{ b.Publisher }</dd>
				}
				if b.Published != "" {
					<dt>Published</dt>
					<dd>{ b.Published }</dd>
				}
				<dt>Added</dt>
				<dd>{ b.Added }</dd>
			</dl>
		</div>
	</section>
	if b.Description != "" {
		<section class="card">
			<h2>About</h2>
			<p>{ b.Description }</p>
		</section>
	}
	<section class="card">
		<h2>Files</h2>
		if len(b.Files) == 0 {
			<p class="muted">
				This book is catalogued but its content is no longer stored.
			</p>
		} else {
			<table>
				<tr><th>Name</th><th>Type</th><th></th></tr>
				for _, f := range b.Files {
					<tr>
						<td>{ f.Name }</td>
						<td>{ f.MediaType }</td>
						<td><a href={ prefix + "books/" + b.ID + "/download" }>Download</a></td>
					</tr>
				}
			</table>
		}
	</section>
	if b.CanWrite {
		@bookEditForm(prefix, csrf, b)
		if b.Lookup.Offered {
			@bookLookupPanel(prefix, csrf, b)
		}
	}
	<p><a href={ prefix + "books?library=" + b.LibraryID }>Back to the library</a></p>
}
