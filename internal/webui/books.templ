package webui

// Books: the browser side of the catalog — pick a folder, look at what
// is in it, read it or take a copy.

// FolderOption is one watched folder as the picker shows it. It carries
// a name and an id and nothing else: a folder's root path is a
// filesystem oracle and appears only on the admin page (ADR-0017).
type FolderOption struct {
	ID       string
	Name     string
	Selected bool
}

type BookRow struct {
	ID     string
	Title  string
	Author string
	Added  string
	CanGet bool
	// CanRead is set when there is an EPUB to open in the browser
	// reader. A book stored as something else is still downloadable.
	CanRead bool
}

// ChipLink is one entity a book claims, with the page listing everything
// else that claims it.
type ChipLink struct {
	Name string
	URL  string
}

type BookView struct {
	ID          string
	Title       string
	Subtitle    string
	Description string
	Publisher   string
	Published   string
	Added       string
	FolderID    string
	// The file, which is one file: a book is a row over a publication
	// somebody's folder holds, so there is no list here any more.
	Filename  string
	MediaType string
	SHA256    string
	// Present is false for a book the last completed pass could not
	// find. The row stays — it is the record of what the folder held,
	// and of anybody's reading position against it — but there is
	// nothing to download until the file comes back.
	Present bool
	CanRead bool
	Finished bool
	// Progression is the reader's newest known position for this book.
	// Nil means the reader has not opened it on any synced device.
	Progression *float64
	// Retirable is a missing book an administrator may take out of the
	// catalog: admin, file already reported missing, and not in a
	// Calibre folder, where metadata.db is authoritative and the next
	// pass would put the book back (ADR-0022, ADR-0024).
	Retirable bool
	// Deletable is a book an administrator may delete outright: file,
	// row and all. Only where a book could have been uploaded in the
	// first place, because that flag is what marks the one place this
	// server may write under a folder root (ADR-0023, ADR-0025).
	Deletable bool
	Notice    string
	Problem   string
	// SeriesAssign is the assign dialog rendered into the page rather
	// than fetched. It is nil in the ordinary case: with scripting on,
	// htmx swaps the dialog in where the placeholder sits, and building
	// it costs three store reads a reader who is not editing does not
	// need. It is set when the fragment route is reached without htmx,
	// which is what the placeholder's plain link does.
	SeriesAssign *SeriesAssignView
	// Chips are the book's entities as links: the fastest way from one
	// book to the rest of its author or its series.
	Authors []ChipLink
	Series  []ChipLink
	// Byline is the authors as one line, for the hero and the title tag.
	Byline string
}

templ bookPage(prefix string, u userCtx, csrf string, b BookView) {
	@layout(orPlaceholder(b.Title), prefix, u, csrf, bookBody(prefix, csrf, b))
}

templ bookBody(prefix, csrf string, b BookView) {
	if b.Problem != "" {
		<p class="error" role="alert">{ b.Problem }</p>
	}
	if b.Notice != "" {
		<p class="notice" role="status">{ b.Notice }</p>
	}
	<section class="hero">
		<div class="art">
			<img
				src={ prefix + "books/" + b.ID + "/cover?size=full" }
				alt=""
				width="333"
				height="500"
			/>
		</div>
		<div class="facts">
			<h1>{ orPlaceholder(b.Title) }</h1>
			if b.Subtitle != "" {
				<p class="byline">{ b.Subtitle }</p>
			}
			if b.Byline != "" {
				<p class="byline">{ b.Byline }</p>
			}
			<div class="reading-state">
				if b.Finished {
					<span class="tag done">Finished</span>
				} else if b.Progression != nil && *b.Progression > 0 {
					<span class="tag">Reading { pct(*b.Progression) }</span>
					<div class="bar" aria-label={ pct(*b.Progression) + " read" }><span class={ pctClass(*b.Progression) }></span></div>
				} else {
					<span class="tag">Unread</span>
				}
			</div>
			<div class="cta">
				if b.CanRead {
					<a class="btn primary" href={ prefix + "books/" + b.ID + "/read" }>Read</a>
				}
				@markBookButton(prefix, csrf, b.ID, b.Finished)
				if b.Present {
					<a class="btn" href={ prefix + "books/" + b.ID + "/download" }>Download</a>
				}
			</div>
			if len(b.Series) > 0 || len(b.Authors) > 0 {
				<div class="bookrelations">
					if len(b.Series) > 0 {
						<div>
							<span class="eyebrow">Series</span>
							<div class="chips">
					for _, c := range b.Series {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
							</div>
						</div>
					}
					if len(b.Authors) > 0 {
						<div>
							<span class="eyebrow">Contributors</span>
							<div class="chips">
					for _, c := range b.Authors {
						<a class="chip" href={ prefix + c.URL }>{ c.Name }</a>
					}
							</div>
						</div>
					}
				</div>
			}
			<dl class="kv">
				if b.Publisher != "" {
					<dt>Publisher</dt>
					<dd>{ b.Publisher }</dd>
				}
				if b.Published != "" {
					<dt>Published</dt>
					<dd>{ b.Published }</dd>
				}
				<dt>Added</dt>
				<dd>{ b.Added }</dd>
			</dl>
		</div>
	</section>
	if b.Description != "" {
		<section class="card">
			<h2>About</h2>
			<div class="description">
				@descriptionHTML(b.Description)
			</div>
		</section>
	}
	<details class="card bookorganization">
		<summary>Library organization</summary>
		// The dialog is fetched rather than rendered: it is three store
		// reads a reader who is not editing does not need, and htmx swaps it
		// in where this placeholder sits. With scripting off the link is a
		// plain link that comes back here with the dialog already open.
		if b.SeriesAssign != nil {
			@seriesAssignForm(prefix, csrf, *b.SeriesAssign)
		} else {
			<div id="series-assign" class="book-organization-section">
				<h2>Series</h2>
				<p>
					<a
						class="btn"
						href={ prefix + "books/" + b.ID + "/series" }
						hx-get={ prefix + "books/" + b.ID + "/series" }
						hx-target="#series-assign"
						hx-swap="outerHTML"
					>Change this book's series</a>
				</p>
			</div>
		}
		<div class="book-organization-section">
			<h2>File</h2>
		if !b.Present {
			<p class="muted">
				The last look through this folder could not find this book's
				file. Nothing has been deleted — it comes back on its own if
				the file does.
			</p>
			if b.Retirable {
				<form
					method="post"
					action={ prefix + "books/" + b.ID + "/delete" }
					hx-confirm="Remove this book from the catalog? Readers keep what they read, and the file on disk is untouched."
				>
					<input type="hidden" name="csrf" value={ csrf }/>
					<button class="danger" type="submit">Remove from the catalog</button>
					<span class="muted">
						For a file that is not coming back. Anyone who read it keeps
						their reading, as an entry only they can remove.
					</span>
				</form>
			}
		} else {
			<table>
				<tr><th>Name</th><th>Type</th><th></th></tr>
				<tr>
					<td>{ orPlaceholder(b.Filename) }</td>
					<td>{ b.MediaType }</td>
					<td><a href={ prefix + "books/" + b.ID + "/download" }>Download</a></td>
				</tr>
			</table>
			if b.Deletable {
				<form
					method="post"
					action={ prefix + "books/" + b.ID + "/destroy" }
					hx-confirm="Delete this book from the server? The file itself is deleted, for every device. This cannot be undone."
				>
					<input type="hidden" name="csrf" value={ csrf }/>
					<button class="danger" type="submit">Delete this book</button>
					<label class="muted">
						<input type="checkbox" name="forget_reading" value="true"/>
						Also delete my reading history for it
					</label>
					<span class="muted">
						The file is deleted from this server's disk. There is no
						trash to take it back out of. Everybody's reading survives
						unless they remove it themselves; the box above removes
						yours.
					</span>
				</form>
			}
		}
		</div>
	</details>
	<p><a href={ prefix + "library?folder=" + b.FolderID }>Back to the library</a></p>
}

templ markBookForm(prefix, csrf, bookID string, finished bool) {
	<form class="reading-status" method="post" action={ prefix + "books/" + bookID + "/reading-status" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		if finished {
			<button class="linkish" type="submit" name="status" value="unread">Mark unread</button>
		} else {
			<button class="linkish" type="submit" name="status" value="read">Mark read</button>
		}
	</form>
}

templ markBookButton(prefix, csrf, bookID string, finished bool) {
	<form class="reading-status" method="post" action={ prefix + "books/" + bookID + "/reading-status" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		if finished {
			<button class="btn" type="submit" name="status" value="unread">Mark unread</button>
		} else {
			<button class="btn" type="submit" name="status" value="read">Mark read</button>
		}
	</form>
}
