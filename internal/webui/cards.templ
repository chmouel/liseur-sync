package webui

// Cards (ADR-0011). A library is recognised by its covers, so browsing
// is a wall of them rather than a table of titles. The table is not
// deleted: it is the list view behind the toolbar's toggle, for the
// times when scanning five thousand rows beats looking at five thousand
// pictures.

// bookCard is one book in a grid. The cover carries the link, the
// actions appear on hover or on focus, and every number that varies is
// a class rather than a style attribute.
//
// There is no action here that changes anything: a folder's books are
// somebody else's files, and this server only reads them (ADR-0017).
templ bookCard(prefix string, b BookRow) {
	<article class="bookcard">
		<div class="art">
			<a href={ prefix + "books/" + b.ID } title={ orPlaceholder(b.Title) }>
				<img
					src={ prefix + "books/" + b.ID + "/cover?size=thumbnail" }
					alt=""
					loading="lazy"
					decoding="async"
					width="333"
					height="500"
				/>
			</a>
			<div class="actions">
				if b.CanRead {
					<a class="btn" href={ prefix + "books/" + b.ID + "/read" }>Read</a>
				}
				if b.CanGet {
					<a class="btn" href={ prefix + "books/" + b.ID + "/download" }>Get</a>
				}
			</div>
		</div>
		<a class="title" href={ prefix + "books/" + b.ID }>{ orPlaceholder(b.Title) }</a>
		if b.Author != "" {
			<span class="by">{ b.Author }</span>
		} else {
			<span class="by">{ b.Added }</span>
		}
	</article>
}

// workCard is a book being read rather than a book that is held. The
// cover carries on reading — that is what somebody looking at their own
// shelf came for — and the numbers behind it are one sublink away, right
// under the picture. When the work has no catalog book (progress synced
// from a device holding a file this server never saw) the cover falls
// back to a text tile and every link goes to the work's own page.
templ workCard(prefix string, w WorkRow) {
	<article class="bookcard">
		if w.BookID != "" {
			<div class="art">
				<a href={ w.readURL(prefix) } title={ workCardHint(w) }>
					<img
						src={ prefix + "books/" + w.BookID + "/cover?size=thumbnail" }
						alt=""
						loading="lazy"
						decoding="async"
						width="333"
						height="500"
					/>
				</a>
				if w.CanRead {
					<div class="actions">
						<a class="btn" href={ prefix + "books/" + w.BookID + "/read" }>Read</a>
					</div>
				}
				if w.Progression != nil {
					<div class="prog"><span class={ pctClass(*w.Progression) }></span></div>
				}
			</div>
		} else {
			<a class="art art-text" href={ prefix + "works/" + w.ID }>
				<span class="name">{ orPlaceholder(w.Title) }</span>
				if w.Author != "" {
					<span class="count">{ w.Author }</span>
				}
				if w.Progression != nil {
					<span class="big">{ pct(*w.Progression) }</span>
				}
			</a>
		}
		<nav class="sublinks">
			<a href={ prefix + "works/" + w.ID }>Stats</a>
			<a href={ prefix + "works/" + w.ID + "#sessions" }>Sessions</a>
			if w.BookID != "" {
				<a href={ prefix + "books/" + w.BookID }>Book</a>
			}
		</nav>
		<a class="title" href={ w.readURL(prefix) }>{ orPlaceholder(w.Title) }</a>
		<span class="by">
			if w.Pending {
				pending
			} else if w.LastActive != "" {
				{ "read " + w.LastActive }
			}
		</span>
		if w.BookID == "" && w.Progression != nil {
			<div class="prog"><span class={ pctClass(*w.Progression) }></span></div>
		}
	</article>
}

// viewToggle switches a browse page between the grid and the table. It
// posts, like every other preference, so it works with scripting off and
// is remembered on the next page.
templ viewToggle(prefix string, csrf string, back string, current string) {
	<form class="viewtoggle" method="post" action={ prefix + "preferences" }>
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="back" value={ back }/>
		if current == viewGrid {
			<button class="on" type="submit" name="view" value="grid" aria-pressed="true">Grid</button>
			<button type="submit" name="view" value="list" aria-pressed="false">List</button>
		} else {
			<button type="submit" name="view" value="grid" aria-pressed="false">Grid</button>
			<button class="on" type="submit" name="view" value="list" aria-pressed="true">List</button>
		}
	</form>
}

// entityCard is an author, a series or a tag: no cover of its own, so
// the tile says the name and how much of it there is.
templ entityCard(prefix string, v EntitiesView, e EntityRow) {
	<article class="bookcard entitycard">
		<a class="art" href={ prefix + "entities/" + v.Kind + "/" + e.ID }>
			<span class="name">{ e.Name }</span>
			<span class="count">{ plural(e.BookCount, "book") }</span>
		</a>
	</article>
}

// emptyState presents a friendly placeholder with optional call to action.
templ emptyState(title, message, btnText, btnHREF string) {
	<div class="empty-state">
		<h3>{ title }</h3>
		if message != "" {
			<p>{ message }</p>
		}
		if btnText != "" && btnHREF != "" {
			<a class="btn primary" href={ btnHREF }>{ btnText }</a>
		}
	</div>
}
