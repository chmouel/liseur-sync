package webui

import "github.com/chmouel/liseur-sync/internal/store"

templ adminMirrorBody(prefix string, csrf string, v mirrorView, flash Flash) {
	<h2>Mirror reading positions</h2>
	<p class="muted">
		Keep a local account's reading position in step with another
		server, or with several. Each mirror names one peer, one local
		account and one credential. KOReader sync works with any server
		that speaks it, and BookOrbit's own API carries the exact spot in
		the page rather than only how far through the book you are.
	</p>
	@adminFlash(flash)
	if v.FileError != "" {
		<p class="error">
			The configuration file could not be read: { v.FileError }
			Saving the single entry repairs its table; the list cannot be
			edited until the file parses again.
		</p>
	}
	if len(v.Entries) > 0 {
		<section class="card">
			<div class="cardhead">
				<h3>Peers</h3>
			</div>
			<table>
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Protocol</th>
						<th scope="col">Peer</th>
						<th scope="col">Local account</th>
						<th scope="col">State</th>
						<th scope="col">Credential</th>
						<th scope="col"></th>
					</tr>
				</thead>
				for _, e := range v.Entries {
					<tr>
						<td>
							{ e.Name }
							if e.Legacy {
								<br/>
								<small class="muted">the single [mirror] entry</small>
							}
						</td>
						<td>{ e.ProtocolLabel }</td>
						<td><code>{ e.URL }</code></td>
						<td>{ e.Account }</td>
						<td>
							if e.Enabled {
								{ "On" }
							} else {
								<span class="muted">{ "Off" }</span>
							}
						</td>
						<td class="muted">{ e.Credential }</td>
						<td>
							if e.ReadOnly {
								<span class="muted">from the environment</span>
							} else if e.EditHref != "" {
								<a href={ e.EditHref }>Edit</a>
							}
						</td>
					</tr>
				}
			</table>
			<p class="muted">
				The configuration file is read once, at startup. A saved
				change takes effect when liseur-sync restarts.
			</p>
		</section>
	}
	if v.Edit != nil {
		@adminMirrorEditForm(prefix, csrf, v.Users, *v.Edit)
	} else if v.CanAdd {
		<p><a class="btn primary" href={ v.AddHref }>Add a mirror</a></p>
	}
	<section class="card">
		<h3>After saving</h3>
		<p>Restart liseur-sync to apply a saved change. Nothing here is reloaded while the server runs.</p>
		<p class="muted">
			Every enabled mirror runs on its own: its own polling, its own
			backoff, its own bookkeeping. A peer that is down never stops
			this server.
		</p>
	</section>
}

templ adminMirrorEditForm(prefix string, csrf string, users []store.User, v mirrorEditView) {
	<section class="card">
		if v.Original != "" {
			<h3>Edit “{ v.Config.Name }”</h3>
		} else {
			<h3>Add a mirror</h3>
		}
		<form method="post" action={ prefix + "admin/mirror" } autocomplete="off">
			<input type="hidden" name="csrf" value={ csrf }/>
			<input type="hidden" name="original" value={ v.Original }/>
			if v.Legacy {
				<input type="hidden" name="legacy" value="1"/>
			}
			if v.Original == "" {
				<label>Name
					<input name="name" required pattern="[a-z0-9][a-z0-9-]{0,31}" value={ v.Config.Name } placeholder="orbit" autocomplete="off"/>
				</label>
				<p class="muted">
					Lower-case letters, digits and dashes. The name keys this
					mirror's bookkeeping and is part of the device a position
					from it is filed under, so it cannot be changed later:
					renaming means removing this mirror and adding it again.
				</p>
			} else {
				<p>Name <code>{ v.Config.Name }</code></p>
			}
			<label class="check">
				if v.Config.Enabled {
					<input type="checkbox" name="enabled" checked/>
				} else {
					<input type="checkbox" name="enabled"/>
				}
				Enable this mirror
			</label>
			<label>Protocol
				<select name="protocol" required>
					if v.BookOrbit {
						<option value="kosync">KOReader sync</option>
						<option value="bookorbit" selected>BookOrbit API</option>
					} else {
						<option value="kosync" selected>KOReader sync</option>
						<option value="bookorbit">BookOrbit API</option>
					}
				</select>
			</label>
			<p class="muted">
				Changing the protocol clears the saved credential, because
				the two are not interchangeable.
			</p>
			<label>Peer URL
				if v.BookOrbit {
					<input name="base_url" type="url" required value={ v.Config.BaseURL } placeholder="https://orbit.example/api/v1"/>
				} else {
					<input name="base_url" type="url" required value={ v.Config.BaseURL } placeholder="https://reader.example/sync"/>
				}
			</label>
			<label>Local account
				<select name="account" required>
					for _, user := range users {
						if user.Name == v.Config.Account {
							<option value={ user.Name } selected>{ user.Name }</option>
						} else {
							<option value={ user.Name }>{ user.Name }</option>
						}
					}
				</select>
			</label>
			<label>Peer username
				<input name="remote_user" required value={ v.Config.RemoteUser } autocomplete="username"/>
			</label>
			<label>Peer password
				<input name="remote_password" type="password" autocomplete="new-password" placeholder={ mirrorPasswordPlaceholder(v.HasKey) }/>
			</label>
			if v.CredentialFromEnv != "" {
				<p class="muted">
					This mirror's credential comes from <code>{ v.CredentialFromEnv }</code>.
					It is used to test the connection and is never written to
					the configuration file.
				</p>
			} else if v.BookOrbit {
				<p class="muted">
					BookOrbit's API signs in with the account password and
					offers no limited alternative, so this password is kept in
					the configuration file and opens the whole peer account.
					The KOReader option uses a separate key that unlocks
					reading positions and nothing else.
				</p>
			} else {
				<p class="muted">On KOReader sync, the password is converted to the KOReader key and never stored or shown.</p>
			}
			<p class="muted">Leave the password blank to keep the saved credential.</p>
			<label>Device name on peer
				<input name="device_id" required value={ v.Config.DeviceID } placeholder="liseur-sync"/>
			</label>
			if v.BookOrbit {
				<h4>Matching books between the two servers</h4>
				<p class="muted">
					Optional. BookOrbit reports where a file sits on its own
					machine, which is a different path from this one even when
					both are reading the same disk. Filling in both directories
					lets a book be confirmed by its location as well as by its
					size and filename. Leave both blank if the two servers do not
					share storage.
				</p>
				<label>Library directory on the peer
					<input name="peer_path_prefix" value={ v.Config.PeerPathPrefix } placeholder="/books"/>
				</label>
				<label>The same directory here
					<input name="local_path_prefix" value={ v.Config.LocalPathPrefix } placeholder="/srv/library"/>
				</label>
			}
			<label>Your password
				<input name="admin_password" type="password" required autocomplete="current-password"/>
			</label>
			<p class="muted">
				Re-entered to save a setting that reaches another server.
			</p>
			<p>
				Positions cross as percentages on KOReader sync; BookOrbit's
				API carries the exact location in the book instead.
			</p>
			<div class="form-actions">
				<button type="submit" class="primary">Save and test connection</button>
			</div>
		</form>
		if v.Remove {
			@adminMirrorRemoveForm(prefix, csrf, v)
		}
	</section>
}

templ adminMirrorRemoveForm(prefix string, csrf string, v mirrorEditView) {
	<details>
		<summary>Remove this mirror</summary>
		<p class="muted">
			Removing a mirror stops it at the next restart. Its bookkeeping
			stays in the database: adding the same name and peer back
			resumes where it left off.
		</p>
		<form method="post" action={ prefix + "admin/mirror/delete" }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<input type="hidden" name="name" value={ v.Config.Name }/>
			if v.Legacy {
				<input type="hidden" name="legacy" value="1"/>
			}
			<label>Your password
				<input name="admin_password" type="password" required autocomplete="current-password"/>
			</label>
			<button type="submit">Remove</button>
		</form>
	</details>
}
