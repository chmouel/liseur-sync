package webui

templ adminAudiobookshelfBody(prefix string, csrf string, v audiobookshelfAdminView, flash Flash) {
	<h2>Follow audiobooks on Audiobookshelf</h2>
	<p class="muted">
		One Audiobookshelf server, one local account, one API key. Read
		and listened positions cross through matching chapters, and
		listening counts in statistics but not in measured reading pace.
	</p>
	@adminFlash(flash)
	<section class="card">
		<h3>Status</h3>
		<dl class="facts">
			<dt>Running</dt>
			<dd>{ onOff(v.Status.Enabled) }</dd>
			<dt>Saved setting</dt>
			<dd>{ onOff(v.SavedEnabled) }</dd>
			<dt>Server</dt>
			<dd><code>{ orValue(v.SavedURL, "not set") }</code></dd>
			<dt>Local account</dt>
			<dd>{ orValue(v.SavedAccount, "not set") }</dd>
			<dt>Credential</dt>
			<dd>{ v.CredentialSource }</dd>
			<dt>Server version</dt>
			<dd>{ orValue(v.Status.Version, "unknown") }</dd>
			<dt>Last successful pass</dt>
			<dd>
				if v.Status.LastSuccess != nil {
					{ v.Status.LastSuccess.Format("2006-01-02 15:04 UTC") }
				} else {
					{ "Never" }
				}
			</dd>
			<dt>Errors</dt>
			<dd>{ i2s(v.Status.Errors) }</dd>
		</dl>
		if v.RestartRequired {
			<p class="ok">
				The saved settings differ from what this process started with.
				Restart liseur-sync to apply them.
			</p>
		}
	</section>
	if len(v.EnvManaged) > 0 {
		<p class="muted">
			These settings are managed by the environment
			(<code>{ audiobookshelfEnvManagedList(v.EnvManaged) }</code>).
			Change the variables and restart; a form save here would be
			overridden at the next start.
		</p>
	} else if v.NoConfigPath {
		<p class="error">
			The server was not started with a writable configuration file,
			so these settings cannot be changed here. Set them in the
			server's configuration file and restart.
		</p>
	} else if v.FileError != "" {
		<p class="error">
			The configuration file could not be read: { v.FileError }
			Fix it and reload this page before saving.
		</p>
	} else {
		@adminAudiobookshelfForm(prefix, csrf, v)
	}
	<section class="card">
		<h3>After saving</h3>
		<p>Restart liseur-sync to apply a saved change. Nothing here is reloaded while the server runs.</p>
		<p class="muted">
			A save that enables the integration checks that the local account
			exists and that the server accepts the key before writing
			anything. Saving it disabled needs neither a reachable server nor
			a key.
		</p>
	</section>
}

templ adminAudiobookshelfForm(prefix string, csrf string, v audiobookshelfAdminView) {
	<section class="card">
		<h3>Settings</h3>
		<form method="post" action={ prefix + "admin/audiobookshelf" } autocomplete="off">
			<input type="hidden" name="csrf" value={ csrf }/>
			<label class="check">
				if v.SavedEnabled {
					<input type="checkbox" name="enabled" checked/>
				} else {
					<input type="checkbox" name="enabled"/>
				}
				Follow this account's audiobooks
			</label>
			<label>Server URL
				<input name="base_url" type="url" value={ v.SavedURL } placeholder="https://audiobooks.example.com"/>
			</label>
			<p class="muted">
				The root the Audiobookshelf web app is served at. It must not
				carry a username, password, query string or fragment. HTTPS is
				required unless the server runs with <code>insecure_http</code>.
			</p>
			<label>Local account
				<select name="account" required>
					if v.SavedAccount == "" {
						<option value="" selected>Choose an account</option>
					} else {
						<option value="">Choose an account</option>
					}
					for _, name := range v.Accounts {
						if name == v.SavedAccount {
							<option value={ name } selected>{ name }</option>
						} else {
							<option value={ name }>{ name }</option>
						}
					}
				</select>
			</label>
			<p class="muted">
				The local liseur-sync account whose reading is followed. Only
				that account sees the matching page.
			</p>
			<label>API key
				<input name="api_key" type="password" autocomplete="new-password" placeholder={ v.KeyPlaceholder() }/>
			</label>
			<p class="muted">
				Create an API key in Audiobookshelf's account settings. Leave
				it blank to keep the saved key.
			</p>
			if v.CredentialFromEnv {
				<p class="muted">
					The effective key comes from <code>LISEUR_ABS_API_KEY</code>.
					It is used for the connection test and is never written to
					the configuration file.
				</p>
			}
			<label>Your password
				<input name="admin_password" type="password" required autocomplete="current-password"/>
			</label>
			<p class="muted">
				Re-entered to save a setting that reaches another server.
			</p>
			<div class="form-actions">
				<button type="submit" class="primary">Save and test connection</button>
			</div>
		</form>
	</section>
}
