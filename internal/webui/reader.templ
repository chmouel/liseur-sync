package webui

// The reader page (ADR-0007). It deliberately does not use the shared
// layout: a book wants the whole window, and the fewer things share a
// document with publication content the better, even though that
// content is a sandbox away.

type ReaderView struct {
	BookID      string
	Title       string
	BackURL     string
	DownloadURL string
	TokenURL    string
	APIBase    string
	StaticBase string

	// IconURL is the tab icon. Same-origin it is the book's own cover
	// at the icon size, which falls back to the placeholder card for a
	// coverless book, so it is never empty there. On the detached
	// origin a link to the API would be a credentialless cross-origin
	// fetch that can only fail, so it stays empty and the page links
	// IconFallback instead — reader-app.js upgrades it to the cover
	// once its bearer token is in hand.
	IconURL      string
	IconFallback string

	// ScriptNonce is the per-response CSP nonce for the one module tag
	// this page carries. Everything else that executes is an import
	// made by that module ('strict-dynamic'); nothing a publication
	// smuggles in can present it.
	ScriptNonce string

	// Detached says the page is being served from the separate reader
	// origin (ADR-0007 phase 3), where there is no session and no CSRF
	// token. Everything the reader needs then arrives in the URL
	// fragment instead, which is why the server leaves those fields
	// empty rather than guessing them.
	Detached bool
}

templ readerPage(v ReaderView, csrf string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ readerTitle(v.Title) }</title>
			if v.IconURL != "" {
				<link rel="icon" href={ v.IconURL }/>
			} else {
				<link rel="icon" href={ v.IconFallback }/>
			}
			<link rel="stylesheet" href={ v.StaticBase + "style.css" }/>
		</head>
		<body class="reader-body">
			<div
				id="reader-config"
				data-book={ v.BookID }
				data-csrf={ csrf }
				data-token-url={ v.TokenURL }
				data-download-url={ v.DownloadURL }
				data-api-base={ v.APIBase }
				data-detached={ boolAttr(v.Detached) }
				hidden
			></div>
			<header class="reader-bar">
				<button
					type="button"
					id="reader-toc-button"
					class="reader-toc-button"
					title="Table of contents (t)"
					aria-label="Table of contents"
				>&#9776;</button>
				<a class="reader-back" href={ templ.SafeURL(v.BackURL) }>&larr; Back</a>
				<div class="reader-title">
					<strong id="reader-title-text">{ v.Title }</strong>
				</div>
				<div class="reader-meta">
					<span id="reader-chapter"></span>
					<span id="reader-progress-text"></span>
				</div>
				// Appearance settings (ADR-0012): everything here is applied
				// client-side through the engine's user stylesheet and layout
				// attributes, and remembered in this browser only. The server
				// never sees a font choice, which is why there is no form
				// action and no CSRF token anywhere near it.
				<details class="reader-settings" id="reader-settings">
					<summary title="Reader settings" aria-label="Reader settings">Aa</summary>
					<form id="reader-settings-form" autocomplete="off">
						<fieldset>
							<legend>Theme</legend>
							<label class="chip"><input type="radio" name="theme" value="original"/> Publisher</label>
							<label class="chip"><input type="radio" name="theme" value="light"/> Light</label>
							<label class="chip"><input type="radio" name="theme" value="sepia"/> Sepia</label>
							<label class="chip"><input type="radio" name="theme" value="dark"/> Dark</label>
							<label class="chip"><input type="radio" name="theme" value="tokyo-night"/> Tokyo Night</label>
							<label class="chip"><input type="radio" name="theme" value="rose-pine"/> Rosé Pine</label>
							<label class="chip"><input type="radio" name="theme" value="black"/> Black</label>
						</fieldset>
						<fieldset>
							<legend>Font</legend>
							<label class="chip"><input type="radio" name="font" value="publisher"/> Publisher</label>
							<label class="chip"><input type="radio" name="font" value="serif"/> Serif</label>
							<label class="chip"><input type="radio" name="font" value="sans"/> Sans-serif</label>
						</fieldset>
						<label class="row">
							Font size
							<input type="range" name="size" min="70" max="350" step="5"/>
							<output id="reader-size-out"></output>
						</label>
						<label class="row">
							Line spacing
							<select name="spacing">
								<option value="0">Publisher</option>
								<option value="1.2">1.2</option>
								<option value="1.35">1.35</option>
								<option value="1.5">1.5</option>
								<option value="1.7">1.7</option>
								<option value="2">2</option>
							</select>
						</label>
						<div class="row2">
							<label class="chip"><input type="checkbox" name="justify"/> Justify</label>
							<label class="chip"><input type="checkbox" name="hyphenate"/> Hyphenate</label>
						</div>
						<fieldset>
							<legend>Layout</legend>
							<label class="chip"><input type="radio" name="flow" value="paginated"/> Pages</label>
							<label class="chip"><input type="radio" name="flow" value="scrolled"/> Scroll</label>
						</fieldset>
						<label class="row">
							Columns
							<select name="columns">
								<option value="auto">Auto</option>
								<option value="1">1</option>
								<option value="2">2</option>
							</select>
						</label>
						<label class="row">
							Margins
							<select name="margin">
								<option value="narrow">Narrow</option>
								<option value="normal">Normal</option>
								<option value="wide">Wide</option>
							</select>
						</label>
						<button type="button" id="reader-settings-reset">Reset to defaults</button>
					</form>
				</details>
				<button
					type="button"
					id="reader-fullscreen"
					class="reader-fullscreen-btn"
					title="Full screen (f)"
					aria-label="Toggle full screen"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
						stroke="currentColor" stroke-width="2" stroke-linecap="round"
						stroke-linejoin="round">
						<path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3M3 16v3a2 2 0 002 2h3m10 0h3a2 2 0 002-2v-3"></path>
					</svg>
				</button>
			</header>
			<div class="reader-progress"><div id="reader-progress-bar"></div></div>
			<p id="reader-status" class="reader-status">Loading…</p>
			// The table of contents, filled in from the publication's own
			// navigation once the book is open. A drawer over the left
			// edge, the way Komga does it: every entry is the book's, so
			// the labels arrive as text nodes only — nothing a publication
			// writes here is markup.
			<aside id="reader-toc" class="reader-toc" aria-label="Table of contents" hidden>
				<h2>Contents</h2>
				<nav id="reader-toc-list"></nav>
				// Annotations, view-only (ADR-0028): bookmarks, notes, and
				// highlights the engine could not anchor, at their
				// progression. Filled in from the sync API with the same
				// derived token positions use; excerpts and bodies arrive
				// as text nodes only — an annotation is reader-authored,
				// but it is displayed as inertly as publisher content.
				<section id="reader-annotations" class="reader-annotations" hidden>
					<h2>Annotations</h2>
					<nav id="reader-annotations-list"></nav>
				</section>
			</aside>
			<div class="reader-stage">
				<button id="reader-prev" class="reader-turn" type="button" aria-label="Previous page">&lsaquo;</button>
				// foliate-js (ADR-0012) mounts its <foliate-view> element
				// here and loads each chapter into an iframe of its own
				// making, from a blob: URL. A blob document inherits this
				// page's CSP, whose script-src admits only the nonced
				// module tag below and its imports — that policy, plus
				// the transform in reader-app.js that strips scripts from
				// every resource, is why the publication is displayed and
				// none of it runs.
				<div id="reader-view"></div>
				<button id="reader-next" class="reader-turn" type="button" aria-label="Next page">&rsaquo;</button>
			</div>
			// The keyboard help, summoned with "?" like everywhere else. A
			// native dialog: showModal gives focus trapping and Escape for
			// free, so the script only has to open and close it.
			<dialog id="reader-help" class="reader-help" aria-label="Keyboard shortcuts">
				<h2>Keyboard shortcuts</h2>
				<table>
					<tbody>
						<tr><td><kbd>Space</kbd> / <kbd>Shift</kbd>+<kbd>Space</kbd></td><td>Next / previous page</td></tr>
						<tr><td><kbd>&rarr;</kbd> <kbd>&larr;</kbd>, <kbd>PgDn</kbd> <kbd>PgUp</kbd></td><td>Next / previous page</td></tr>
						<tr><td><kbd>l</kbd> <kbd>h</kbd>, <kbd>j</kbd> <kbd>k</kbd></td><td>Next / previous page</td></tr>
						<tr><td><kbd>Home</kbd> / <kbd>End</kbd></td><td>Beginning / end of book</td></tr>
						<tr><td><kbd>t</kbd></td><td>Table of contents</td></tr>
						<tr><td><kbd>f</kbd></td><td>Full screen</td></tr>
						<tr><td><kbd>?</kbd></td><td>This help</td></tr>
						<tr><td><kbd>Esc</kbd></td><td>Close help, contents or settings</td></tr>
					</tbody>
				</table>
				<form method="dialog"><button>Close</button></form>
			</dialog>
			<script type="module" src={ v.StaticBase + "reader-app.js" } nonce={ v.ScriptNonce }></script>
		</body>
	</html>
}
