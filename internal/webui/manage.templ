package webui

templ libraryManagePage(prefix string, u userCtx, csrf string, v LibraryView) {
	@layout("Library management", prefix, u, csrf, libraryManageBody(prefix, csrf, v))
}

templ libraryManageBody(prefix, csrf string, v LibraryView) {
	<h1>Library management</h1>
	<p class="muted">
		Uploads, deleted books and catalog decisions belong here. The Library
		page stays focused on browsing and reading.
	</p>
	if len(v.Libraries) == 0 {
		<section class="card">
			<p class="muted">You do not manage any libraries.</p>
		</section>
	} else {
		<form class="toolbar" method="get" action={ prefix + "library/manage" }>
			<label for="manage-library-pick">Library</label>
			<select id="manage-library-pick" name="library">
				for _, l := range v.Libraries {
					if l.Selected {
						<option value={ l.ID } selected>{ l.Name }</option>
					} else {
						<option value={ l.ID }>{ l.Name }</option>
					}
				}
			</select>
			<noscript><button type="submit">Show</button></noscript>
		</form>
		if len(v.Uploads) == 0 && len(v.Trash) == 0 && len(v.Review) == 0 && len(v.Duplicates) == 0 && len(v.Similar) == 0 {
			<section class="card">
				<p class="muted">Nothing needs attention in this library.</p>
			</section>
		} else {
			@librarianQueues(prefix, csrf, v)
		}
	}
}
